@model IEnumerable<Department>
@using HMSYSTEM.ViewModels
@{
    ViewData["Title"] = "Department Management";
}

<!-- Premium Modern Styles for Department Index -->
<style>
    .department-card {
        border: none !important;
        border-radius: 16px !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important;
        background: #ffffff;
        overflow: hidden;
    }
    
    .department-card-header {
        background: #ffffff !important;
        border-bottom: 1px solid #f1f2f6 !important;
        padding: 1.5rem 2rem !important;
    }

    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .header-title-block {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .header-icon {
        width: 44px;
        height: 44px;
        background: rgba(49, 130, 206, 0.1);
        color: #3182ce;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .department-card-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #2d3748;
        margin: 0;
    }

    .department-card-subtitle {
        font-size: 0.82rem;
        color: #718096;
        margin: 2px 0 0 0;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    /* Search Input Custom Design */
    .search-wrapper {
        position: relative;
        min-width: 260px;
    }

    .search-wrapper .search-icon {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #a0aec0;
        font-size: 0.95rem;
        pointer-events: none;
        z-index: 5;
    }

    .search-wrapper input.search-control {
        padding-left: 50px !important;
        padding-right: 15px !important;
        border-radius: 30px !important;
        border: 1.5px solid #e2e8f0 !important;
        font-size: 0.9rem !important;
        height: 42px !important;
        transition: all 0.3s ease !important;
        box-shadow: none !important;
        background-color: #f7fafc !important;
    }

    .search-wrapper input.search-control:focus {
        border-color: #3182ce !important;
        background-color: #ffffff !important;
        box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.15) !important;
    }

    /* Create Button Custom Design */
    .btn-gradient-create {
        background: linear-gradient(135deg, #3182ce 0%, #2b6cb0 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 30px !important;
        padding: 0 1.5rem !important;
        font-weight: 700 !important;
        font-size: 0.9rem !important;
        height: 42px !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(49, 130, 206, 0.3) !important;
        transition: all 0.3s ease !important;
        cursor: pointer;
        text-decoration: none !important;
    }

    .btn-gradient-create:hover {
        transform: translateY(-1.5px);
        box-shadow: 0 6px 20px rgba(49, 130, 206, 0.4) !important;
        color: #ffffff !important;
    }

    /* Custom Table Design */
    .table-container {
        padding: 1rem 1.5rem !important;
    }

    #departmentTable {
        border-collapse: separate !important;
        border-spacing: 0 !important;
        width: 100% !important;
        border: none !important;
    }

    #departmentTable th {
        background-color: #f7fafc !important;
        color: #4a5568 !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        font-size: 0.75rem !important;
        letter-spacing: 0.8px !important;
        padding: 16px 20px !important;
        border-bottom: 2px solid #edf2f7 !important;
        border-top: none !important;
    }

    #departmentTable td {
        padding: 16px 20px !important;
        vertical-align: middle !important;
        border-bottom: 1px solid #edf2f7 !important;
        color: #2d3748 !important;
        font-size: 0.9rem !important;
    }

    #departmentTable tbody tr {
        transition: background-color 0.2s ease;
    }

    #departmentTable tbody tr:hover {
        background-color: #f7fafc !important;
    }

    /* Action Buttons Group */
    .action-btn-group {
        display: flex;
        justify-content: center;
        gap: 8px;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        text-decoration: none !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 0.9rem;
        border: 1px solid transparent;
    }

    .action-edit {
        background-color: #ebf8ff;
        color: #2b6cb0;
        border-color: #bee3f8;
    }

    .action-edit:hover {
        background-color: #3182ce;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(49, 130, 206, 0.2);
    }

    .action-delete {
        background-color: #fff5f5;
        color: #e53e3e;
        border-color: #fed7d7;
    }

    .action-delete:hover {
        background-color: #e53e3e;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(229, 62, 62, 0.2);
    }

    /* Status Badges */
    .badge-status {
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 0.75rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
    }

    .status-active {
        background-color: #c6f6d5;
        color: #22543d;
    }

    .status-inactive {
        background-color: #fed7d7;
        color: #742a2a;
    }

    /* Modal Form Styling */
    .modal-content {
        border: none !important;
        border-radius: 16px !important;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1) !important;
        overflow: hidden;
    }

    .modal-header {
        background: linear-gradient(135deg, #3182ce 0%, #2b6cb0 100%) !important;
        color: #ffffff !important;
        border-bottom: none !important;
        padding: 1.25rem 1.75rem !important;
    }

    .modal-title {
        font-weight: 800 !important;
        font-size: 1.15rem !important;
    }

    .modal-body {
        padding: 2rem 1.75rem !important;
        background-color: #fcfcfd;
    }

    .modal-footer {
        border-top: 1px solid #edf2f7 !important;
        background-color: #f7fafc !important;
        padding: 1rem 1.75rem !important;
    }

    .form-control {
        border-radius: 8px !important;
        border: 1.5px solid #e2e8f0 !important;
        padding: 10px 14px !important;
        font-size: 0.9rem !important;
        transition: all 0.2s ease !important;
    }

    .form-control:focus {
        border-color: #3182ce !important;
        box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.15) !important;
    }

    .btn-save {
        background-color: #3182ce !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        border-radius: 30px !important;
        padding: 0.6rem 2.2rem !important;
        border: none !important;
        transition: all 0.25s ease !important;
        box-shadow: 0 4px 10px rgba(49, 130, 206, 0.2) !important;
    }

    .btn-save:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 15px rgba(49, 130, 206, 0.3) !important;
    }

    .btn-close-modal {
        border-radius: 30px !important;
        padding: 0.6rem 2rem !important;
        font-weight: 700 !important;
        transition: all 0.25s ease !important;
    }

    /* Toastr Custom Design Overrides to fix white text visibility */
    #toast-container > .toast-success {
        background-color: #2f855a !important;
        color: #ffffff !important;
        opacity: 1 !important;
        box-shadow: 0 4px 14px rgba(47, 133, 90, 0.3) !important;
    }
    #toast-container > .toast-error {
        background-color: #c53030 !important;
        color: #ffffff !important;
        opacity: 1 !important;
        box-shadow: 0 4px 14px rgba(197, 48, 48, 0.3) !important;
    }
    #toast-container > .toast {
        background-image: none !important;
        padding: 15px 20px 15px 50px !important;
        border-radius: 10px !important;
        border: none !important;
    }
    #toast-container .toast-message,
    #toast-container .toast-title {
        color: #ffffff !important;
        font-weight: 600 !important;
    }

    /* Pagination Styles */
    .pagination .page-link {
        box-shadow: none !important;
    }
    
    .pagination .page-item:not(.disabled) .page-link:hover {
        background-color: #3182ce !important;
        color: #ffffff !important;
        border-color: #3182ce !important;
    }
    
    .pagination .page-item.disabled .page-link {
        color: #a0aec0 !important;
        background-color: #f7fafc !important;
        border-color: #edf2f7 !important;
        pointer-events: none;
    }
</style>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card department-card mb-4">
                
                <!-- Premium Card Header -->
                <div class="card-header department-card-header">
                    <div class="header-container">
                        <div class="header-title-block">
                            <div class="header-icon">
                                <i class="fas fa-hospital"></i>
                            </div>
                            <div>
                                <h3 class="department-card-title">Existing Department List</h3>
                                <p class="department-card-subtitle">Manage medical units and clinical departments.</p>
                            </div>
                        </div>
                        <div class="header-actions">
                            <div class="d-flex align-items-center gap-2">
                                <div class="search-wrapper">
                                    <i class="fas fa-search search-icon"></i>
                                    <input type="text" class="form-control search-control" placeholder="Search Department..." id="departmentName" />
                                </div>
                                <button type="button" class="btn btn-primary" id="btnSearch" style="border-radius: 30px; height: 42px; padding: 0 1.5rem; font-weight: 700; background-color: #3182ce; border-color: #3182ce; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 14px rgba(49, 130, 206, 0.25);">
                                    <i class="fas fa-search"></i> Search
                                </button>
                            </div>
                            <button type="button" class="btn btn-gradient-create" data-bs-toggle="modal" data-bs-target="#addDepartmentModal">
                                <i class="fas fa-plus-circle me-2"></i> Create
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body table-container">
                    <table id="departmentTable" class="table table-hover">
                        <thead>
                            <tr>
                                <th style="width: 80px">Sl No</th>
                                <th>Department Name</th>
                                <th>Status</th>
                                <th style="width: 120px; text-align: center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="dataTable">
                            <!-- Populated dynamically via AJAX -->
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                <div class="card-footer" style="background-color: #ffffff; border-top: 1px solid #f1f2f6; padding: 1.25rem 2rem;">
                    <div class="row align-items-center">
                        <div class="col-sm-6 text-center text-sm-start mb-3 mb-sm-0">
                            <div class="text-muted" style="font-size: 0.85rem;">
                                Showing page <span id="cpage" class="fw-bold text-dark">0</span> of <span id="tpage" class="fw-bold text-dark">0</span> (<span id="tentries" class="fw-bold text-dark">0</span> total entries)
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <nav aria-label="Page navigation" class="d-flex justify-content-center justify-content-sm-end">
                                <ul class="pagination pagination-sm m-0" style="gap: 5px;">
                                    <li class="page-item" id="prevLi">
                                        <a id="btnPrevious" class="page-link" href="javascript:void(0);" style="border-radius: 30px !important; padding: 6px 18px; font-weight: 700; color: #4a5568; border-color: #e2e8f0; transition: all 0.2s ease;">⬅️ Previous</a>
                                    </li>
                                    <li class="page-item" id="nextLi">
                                        <a id="btnNext" class="page-link" href="javascript:void(0);" style="border-radius: 30px !important; padding: 6px 18px; font-weight: 700; color: #4a5568; border-color: #e2e8f0; transition: all 0.2s ease;">Next ➡️</a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Add Department Modal -->
<div class="modal fade" id="addDepartmentModal" tabindex="-1" aria-labelledby="addDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addDepartmentModalLabel">
                    <i class="fas fa-plus-circle me-2"></i> Create Department
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: brightness(0) invert(1);"></button>
            </div>
            <form asp-controller="Department" asp-action="Save" method="post" id="addDepartmentForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="addDepartmentName" class="form-label" style="font-weight: 700; color: #4a5568;">Department Name</label>
                        <input name="DepartmentName" id="addDepartmentName" class="form-control" placeholder="Enter department name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label d-block" style="font-weight: 700; color: #4a5568;">Status</label>
                        <div class="form-check form-check-inline mt-1">
                            <input class="form-check-input" type="radio" name="Status" value="true" id="addStatusActive" checked />
                            <label class="form-check-label" for="addStatusActive" style="font-weight: 600; color: #4a5568;">Active</label>
                        </div>
                        <div class="form-check form-check-inline mt-1">
                            <input class="form-check-input" type="radio" name="Status" value="false" id="addStatusInactive" />
                            <label class="form-check-label" for="addStatusInactive" style="font-weight: 600; color: #4a5568;">Inactive</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-center">
                    <button type="submit" class="btn btn-save">
                        <i class="fas fa-save me-2"></i> Save
                    </button>
                    <button type="button" class="btn btn-secondary btn-close-modal" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i> Close
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Department Modal -->
<div class="modal fade" id="editDepartmentModal" tabindex="-1" aria-labelledby="editDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editDepartmentModalLabel">
                    <i class="fas fa-edit me-2"></i> Edit Department
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: brightness(0) invert(1);"></button>
            </div>
            <form asp-controller="Department" asp-action="Update" method="post" id="editDepartmentForm">
                <input type="hidden" name="DepartmentId" id="editDepartmentId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editDepartmentName" class="form-label" style="font-weight: 700; color: #4a5568;">Department Name</label>
                        <input name="DepartmentName" id="editDepartmentName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label d-block" style="font-weight: 700; color: #4a5568;">Status</label>
                        <div class="form-check form-check-inline mt-1">
                            <input class="form-check-input" type="radio" name="Status" value="true" id="editStatusActive" />
                            <label class="form-check-label" for="editStatusActive" style="font-weight: 600; color: #4a5568;">Active</label>
                        </div>
                        <div class="form-check form-check-inline mt-1">
                            <input class="form-check-input" type="radio" name="Status" value="false" id="editStatusInactive" />
                            <label class="form-check-label" for="editStatusInactive" style="font-weight: 600; color: #4a5568;">Inactive</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-center">
                    <button type="submit" class="btn btn-save">
                        <i class="fas fa-save me-2"></i> Update
                    </button>
                    <button type="button" class="btn btn-secondary btn-close-modal" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i> Close
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    var currentPage = 1;
    var totalPages = 1;

    // Helper notification wrappers
    function showSuccess(message) {
        if (typeof toastr !== 'undefined') {
            toastr.success(message);
        } else {
            alert(message);
        }
    }

    function showError(message) {
        if (typeof toastr !== 'undefined') {
            toastr.error(message);
        } else {
            alert(message);
        }
    }

    // Helper function to create row HTML for a department
    function createrow(index, item) {
        var statusBadge = item.status === true 
            ? `<span class="badge-status status-active"><i class="fas fa-check-circle me-2"></i>Active</span>`
            : `<span class="badge-status status-inactive"><i class="fas fa-times-circle me-2"></i>Inactive</span>`;

        return `<tr>
            <td>${index}</td>
            <td style="font-weight: 700; color: #2d3748;">${item.departmentName || ''}</td>
            <td>${statusBadge}</td>
            <td>
                <div class="action-btn-group">
                    <a class="action-btn action-edit edit-department-btn" href="javascript:void(0);" data-id="${item.departmentId}" title="Edit Department">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a class="action-btn action-delete delete-department-btn" href="javascript:void(0);" data-id="${item.departmentId}" title="Delete Department">
                        <i class="fas fa-trash"></i>
                    </a>
                </div>
            </td>
        </tr>`;
    }

    // Function to load departments via AJAX and update #dataTable directly
    function loadDepartments(page) {
        currentPage = page || 1;

        $("#dataTable").html(`
            <tr>
                <td colspan="4" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted mb-0">Loading departments...</p>
                </td>
            </tr>
        `);

        var searchQuery = $('#departmentName').val() || '';

        $.ajax({
            url: "@Url.Action("GetDepartments", "Department")",
            type: "GET",
            data: {
                search: searchQuery,
                page: currentPage,
                pageSize: 10
            },
            success: function (response) {
                if (response.issuccess === true) {
                    $("#dataTable").empty();

                    totalPages = response.totalPages || 1;
                    var totalItem = response.totalItem || 0;

                    // Update UI indicators
                    $("#cpage").text(currentPage);
                    $("#tpage").text(totalPages);
                    $("#tentries").text(totalItem);

                    // Update pagination buttons state
                    if (currentPage <= 1) {
                        $("#prevLi").addClass("disabled");
                    } else {
                        $("#prevLi").removeClass("disabled");
                    }

                    if (currentPage >= totalPages) {
                        $("#nextLi").addClass("disabled");
                    } else {
                        $("#nextLi").removeClass("disabled");
                    }

                    if (response.data && response.data.length > 0) {
                        $.each(response.data, function (i, v) {
                            var rowIdx = ((currentPage - 1) * 10) + (i + 1);
                            var row = createrow(rowIdx, v);
                            $("#dataTable").append(row);
                        });
                    } else {
                        $("#dataTable").html(`
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="fas fa-info-circle fs-4"></i>
                                    <p class="mt-2 mb-0">No departments found.</p>
                                </td>
                            </tr>
                        `);
                    }
                } else {
                    $("#dataTable").html(`
                        <tr>
                            <td colspan="4" class="text-center py-4 text-danger">
                                <i class="fas fa-exclamation-triangle fs-4"></i>
                                <p class="mt-2 mb-0">Failed to load data.</p>
                            </td>
                        </tr>
                    `);
                }
            },
            error: function (xhr, textStatus, error) {
                $("#dataTable").html(`
                    <tr>
                        <td colspan="4" class="text-center py-4 text-danger">
                            <i class="fas fa-exclamation-triangle fs-4"></i>
                            <p class="mt-2 mb-0">Failed to load data: ${error || xhr.statusText}</p>
                        </td>
                    </tr>
                `);
            }
        });
    }

    function changePage(direction) {
        var targetPage = currentPage + direction;
        if (targetPage >= 1 && targetPage <= totalPages) {
            loadDepartments(targetPage);
        }
    }

    $(document).ready(function () {
        // Load departments on init
        loadDepartments(1);

        // Click handlers for next/previous links
        $('#btnPrevious').on('click', function (e) {
            e.preventDefault();
            changePage(-1);
        });

        $('#btnNext').on('click', function (e) {
            e.preventDefault();
            changePage(1);
        });

        // Search button click handler
        $('#btnSearch').on('click', function () {
            loadDepartments(1);
        });

        // Trigger search on Enter keypress inside search box
        $('#departmentName').on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                loadDepartments(1);
            }
        });

        // Handle Add Department Form Submission via AJAX
        $('#addDepartmentForm').on('submit', function (e) {
            e.preventDefault();
            var form = $(this);
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (response) {
                    if (response.success) {
                        showSuccess(response.message);
                        $('#addDepartmentModal').modal('hide');
                        form[0].reset();
                        loadDepartments(1);
                    } else {
                        showError(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    showError("An error occurred: " + error);
                }
            });
        });

        // Handle Edit click: Fetch details via AJAX and open modal
        $(document).on('click', '.edit-department-btn', function () {
            var id = $(this).data('id');
            $.getJSON('@Url.Action("GetDepartmentById", "Department")', { id: id }, function (data) {
                $('#editDepartmentId').val(data.departmentId);
                $('#editDepartmentName').val(data.departmentName);
                if (data.status === true) {
                    $('#editStatusActive').prop('checked', true);
                } else {
                    $('#editStatusInactive').prop('checked', true);
                }
                $('#editDepartmentModal').modal('show');
            }).fail(function () {
                showError("Error loading department data.");
            });
        });

        // Handle Edit Department Form Submission via AJAX
        $('#editDepartmentForm').on('submit', function (e) {
            e.preventDefault();
            var form = $(this);
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (response) {
                    if (response.success) {
                        showSuccess(response.message);
                        $('#editDepartmentModal').modal('hide');
                        loadDepartments(currentPage);
                    } else {
                        showError(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    showError("An error occurred: " + error);
                }
            });
        });

        // Handle Delete click
        $(document).on('click', '.delete-department-btn', function (e) {
            e.preventDefault();
            var id = $(this).data('id');
            if (confirm("Are you sure you want to delete this department?")) {
                var clickedBtn = $(this);
                clickedBtn.css('pointer-events', 'none');
                $.ajax({
                    url: '/Department/Delete/' + id,
                    type: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (response) {
                        if (response.success) {
                            showSuccess(response.message);
                            loadDepartments(currentPage);
                        } else {
                            showError(response.message);
                            clickedBtn.css('pointer-events', 'auto');
                        }
                    },
                    error: function (xhr, status, error) {
                        showError("An error occurred: " + error);
                        clickedBtn.css('pointer-events', 'auto');
                    }
                });
            }
        });

        // Check for editId URL query parameter and trigger edit if present
        const urlParams = new URLSearchParams(window.location.search);
        const editId = urlParams.get('editId');
        if (editId) {
            const editBtn = $(`.edit-department-btn[data-id="${editId}"]`);
            if (editBtn.length) {
                editBtn.click();
            } else {
                $.getJSON('@Url.Action("GetDepartmentById", "Department")', { id: editId }, function (data) {
                    $('#editDepartmentId').val(data.departmentId);
                    $('#editDepartmentName').val(data.departmentName);
                    if (data.status === true) {
                        $('#editStatusActive').prop('checked', true);
                    } else {
                        $('#editStatusInactive').prop('checked', true);
                    }
                    $('#editDepartmentModal').modal('show');
                });
            }
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    });
</script>