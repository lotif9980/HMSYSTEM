@using HMSYSTEM.ViewModels
@model List<WardBedViewModel>
@{
    ViewData["Title"] = "Ward Bed Occupancy Report";
    int totalBeds = Model != null ? Model.Count : 0;
    int occupiedCount = Model != null ? Model.Count(m => m.IsOccupied) : 0;
    int availableCount = Model != null ? Model.Count(m => !m.IsOccupied) : 0;
}

<!-- Custom Styles for Ward Bed Report -->
<style>
    .report-card {
        border: none !important;
        border-radius: 16px !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important;
        background: #ffffff;
        overflow: hidden;
    }

    .report-card-header {
        background: #ffffff !important;
        border-bottom: 1px solid #f1f2f6 !important;
        padding: 1.5rem 2rem !important;
    }

    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .header-title-block {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .header-icon {
        width: 44px;
        height: 44px;
        background: rgba(49, 130, 206, 0.1);
        color: #3182ce;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .report-card-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #2d3748;
        margin: 0;
    }

    .report-card-subtitle {
        font-size: 0.82rem;
        color: #718096;
        margin: 2px 0 0 0;
    }

    /* Metric Stat Pill Badges */
    .stat-box {
        background: #f7fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .print-only {
        display: none;
    }

    .report-print-header {
        border-bottom: 2px solid #2b6cb0;
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .hospital-info-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: #2b6cb0;
        margin: 0;
    }

    .hospital-info-sub {
        font-size: 0.85rem;
        color: #4a5568;
        margin: 2px 0 0 0;
    }

    .report-title-badge {
        background-color: #ebf8ff;
        color: #2b6cb0;
        border: 1px solid #bee3f8;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .generated-date {
        font-size: 0.75rem;
        color: #718096;
        text-align: right;
        margin-top: 4px;
    }

    /* Print Styles */
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 10mm;
        }

        .no-print, form, .btn, nav, header, footer {
            display: none !important;
        }

        .print-only {
            display: flex !important;
        }

        body {
            background: white !important;
            font-size: 10pt !important;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .print-container {
            width: 100% !important;
            max-width: 210mm !important;
            margin: 0 auto !important;
            padding: 0 !important;
            box-shadow: none !important;
        }

        table th, table td {
            border: 1px solid #cbd5e0 !important;
            padding: 8px 10px !important;
        }
    }
</style>

<div class="container-fluid mt-4 print-container">
    <div class="card report-card mb-4">

        <!-- Standardized Print Header -->
        <div class="report-print-header print-only">
            <div>
                <h2 class="hospital-info-title">HMS Hospital Management</h2>
                <p class="hospital-info-sub">Charghat, Rajshahi • Mobile: 01791177192</p>
            </div>
            <div>
                <div class="report-title-badge">
                    Ward & Bed Occupancy Report
                </div>
                <div class="generated-date">
                    Generated: @DateTime.Now.ToString("dd-MM-yyyy hh:mm tt")
                </div>
            </div>
        </div>

        <!-- Card Header (Screen Display) -->
        <div class="card-header report-card-header no-print">
            <div class="header-container">
                <div class="header-title-block">
                    <div class="header-icon">
                        <i class="fas fa-bed"></i>
                    </div>
                    <div>
                        <h3 class="report-card-title">Ward & Bed Occupancy Report</h3>
                        <p class="report-card-subtitle">Real-time status of hospital ward capacities and bed availability.</p>
                    </div>
                </div>
                <div>
                    <a asp-controller="Report" asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 30px; font-weight: 700;">
                        <i class="fas fa-arrow-left me-1"></i> Reports Hub
                    </a>
                </div>
            </div>
        </div>

        <!-- Filter Form -->
        <div class="card-body bg-light border-bottom p-4 no-print">
            <form asp-action="GetWardBedStatus" method="post">
                <div class="row align-items-end g-3 justify-content-center">
                    <div class="col-md-5">
                        <label class="form-label fw-bold text-dark fs-6">Select Hospital Ward</label>
                        <select name="wardId" class="form-select ward-dropdown">
                            <option value="">-- All Wards --</option>
                            @if (ViewBag.Ward != null)
                            {
                                foreach (var ward in ViewBag.Ward as List<SelectListItem>)
                                {
                                    <option value="@ward.Value">@ward.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100" style="border-radius: 30px; height: 42px; font-weight: 700; background-color: #3182ce; border-color: #3182ce;">
                            <i class="fas fa-filter me-1"></i> Filter Status
                        </button>
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-warning w-100 text-white" onclick="window.print()" style="border-radius: 30px; height: 42px; font-weight: 700; background-color: #ed8936; border: none;">
                            <i class="fas fa-print me-1"></i> Print Report
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Summary KPI Cards -->
        @if (Model != null && Model.Any())
        {
            <div class="card-body border-bottom p-4">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="stat-box">
                            <div class="stat-icon bg-primary text-white">
                                <i class="fas fa-bed"></i>
                            </div>
                            <div>
                                <div class="text-muted small fw-bold uppercase">Total Beds</div>
                                <div class="fs-4 fw-bold text-dark">@totalBeds</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-box">
                            <div class="stat-icon bg-danger text-white">
                                <i class="fas fa-user-check"></i>
                            </div>
                            <div>
                                <div class="text-muted small fw-bold uppercase">Occupied Beds</div>
                                <div class="fs-4 fw-bold text-danger">@occupiedCount</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-box">
                            <div class="stat-icon bg-success text-white">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div>
                                <div class="text-muted small fw-bold uppercase">Available Beds</div>
                                <div class="fs-4 fw-bold text-success">@availableCount</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Report Data Table -->
        <div class="card-body p-4">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 250px;">Ward Name</th>
                                <th style="width: 70px;">Sl No</th>
                                <th>Bed Number</th>
                                <th style="width: 150px; text-align: center;">Occupancy Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var wardGroup in Model.GroupBy(m => m.WardName))
                            {
                                var beds = wardGroup.ToList();
                                for (int i = 0; i < beds.Count; i++)
                                {
                                    <tr>
                                        @if (i == 0)
                                        {
                                            <td rowspan="@beds.Count" class="fw-bold bg-white align-middle text-primary fs-6">
                                                <i class="fas fa-hospital-alt me-2 text-info"></i> @wardGroup.Key
                                            </td>
                                        }
                                        <td>@(i + 1)</td>
                                        <td class="fw-bold">🛏️ @beds[i].BedNumber</td>
                                        <td style="text-align: center;">
                                            @if (beds[i].IsOccupied)
                                            {
                                                <span class="badge bg-danger" style="padding: 6px 14px; border-radius: 20px;"><i class="fas fa-user-lock me-1"></i> Occupied</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success" style="padding: 6px 14px; border-radius: 20px;"><i class="fas fa-check-circle me-1"></i> Available</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-bed fs-1 text-secondary mb-3 d-block"></i>
                    <h5>No Bed Status Data Available</h5>
                    <p class="mb-0">Select a ward above and click <strong>Filter Status</strong> to generate the report.</p>
                </div>
            }
        </div>

    </div>
</div>
