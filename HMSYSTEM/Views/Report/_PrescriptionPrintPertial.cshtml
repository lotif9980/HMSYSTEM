@model List<HMSYSTEM.ViewModels.PrescriptionViewModel>

<style type="text/css">
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 10mm;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 10pt;
            color: #000000;
            background: #ffffff !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        #PrescriptionPrintArea {
            width: 100% !important;
            max-width: 210mm !important;
            margin: 0 auto !important;
            padding: 0 !important;
            box-shadow: none !important;
            border: none !important;
        }

        button, .btn, .no-print {
            display: none !important;
        }
    }

    #PrescriptionPrintArea {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #2d3748;
        background: #ffffff;
        padding: 1.5rem;
        max-width: 210mm;
        margin: 0 auto;
    }

    .report-print-header {
        border-bottom: 2px solid #2b6cb0;
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .hospital-info-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: #2b6cb0;
        margin: 0;
    }

    .hospital-info-sub {
        font-size: 0.85rem;
        color: #4a5568;
        margin: 2px 0 0 0;
    }

    .report-title-badge {
        background-color: #ebf8ff;
        color: #2b6cb0;
        border: 1px solid #bee3f8;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .generated-date {
        font-size: 0.75rem;
        color: #718096;
        text-align: right;
        margin-top: 4px;
    }

    .print-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
    }

    .print-table th {
        background-color: #f7fafc !important;
        color: #2d3748 !important;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        padding: 10px 12px;
        border: 1px solid #cbd5e0;
    }

    .print-table td {
        padding: 10px 12px;
        font-size: 0.88rem;
        border: 1px solid #e2e8f0;
        color: #2d3748;
    }
</style>

<div id="PrescriptionPrintArea">

    <!-- Standardized Hospital Header -->
    <div class="report-print-header">
        <div>
            <h2 class="hospital-info-title">HMS Hospital Management</h2>
            <p class="hospital-info-sub">Charghat, Rajshahi • Mobile: 01791177192</p>
        </div>
        <div>
            <div class="report-title-badge">
                Prescription Medical Report
            </div>
            <div class="generated-date">
                Generated: @DateTime.Now.ToString("dd-MM-yyyy hh:mm tt")
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <table class="print-table">
        <thead>
            <tr>
                <th style="width: 50px;">Sl</th>
                <th style="width: 110px;">Prescription Date</th>
                <th>Patient Name</th>
                <th style="width: 130px;">Phone Number</th>
                <th>Prescribing Doctor</th>
                <th style="width: 140px;">Next Follow-Up Date</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int count = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@count</td>
                        <td style="font-family: monospace;">@(item.Date?.ToString("dd-MM-yyyy") ?? "N/A")</td>
                        <td style="font-weight: 700;">@item.PatientName</td>
                        <td style="font-family: monospace;">@item.PatientMobileNo</td>
                        <td>Dr. @item.DoctorName</td>
                        <td>@(item.NextFlowUp?.ToString("dd-MM-yyyy") ?? "No Follow-up")</td>
                    </tr>
                    count++;
                }
            }
            else
            {
                <tr>
                    <td colspan="6" style="text-align: center; color: #718096; padding: 20px;">
                        No prescription records found for the selected period.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
