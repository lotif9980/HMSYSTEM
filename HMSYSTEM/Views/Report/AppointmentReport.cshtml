@using HMSYSTEM.ViewModels
@model List<AppointmentVM>
@{
    ViewData["Title"] = "Appointment Analytics Report";
    int totalCount = Model != null ? Model.Count : 0;
}

<!-- Custom Styles for Appointment Report -->
<style>
    .report-card {
        border: none !important;
        border-radius: 16px !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important;
        background: #ffffff;
        overflow: hidden;
    }

    .report-card-header {
        background: #ffffff !important;
        border-bottom: 1px solid #f1f2f6 !important;
        padding: 1.5rem 2rem !important;
    }

    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .header-title-block {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .header-icon {
        width: 44px;
        height: 44px;
        background: rgba(128, 90, 213, 0.1);
        color: #805ad5;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .report-card-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #2d3748;
        margin: 0;
    }

    .report-card-subtitle {
        font-size: 0.82rem;
        color: #718096;
        margin: 2px 0 0 0;
    }

    /* Print Styles */
    @@media print {
        .no-print, form, .btn, nav, header, footer {
            display: none !important;
        }

        body {
            background: white !important;
            font-size: 11pt !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .print-container {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            box-shadow: none !important;
        }

        table th, table td {
            border: 1px solid #cbd5e0 !important;
            padding: 6px 10px !important;
        }
    }
</style>

<div class="container-fluid mt-4 print-container">
    <div class="card report-card mb-4">

        <!-- Card Header -->
        <div class="card-header report-card-header no-print">
            <div class="header-container">
                <div class="header-title-block">
                    <div class="header-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div>
                        <h3 class="report-card-title">Appointment Analytics Report</h3>
                        <p class="report-card-subtitle">Review appointment consultations, serial numbers, and patient visit history.</p>
                    </div>
                </div>
                <div>
                    <a asp-controller="Report" asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 30px; font-weight: 700;">
                        <i class="fas fa-arrow-left me-1"></i> Reports Hub
                    </a>
                </div>
            </div>
        </div>

        <!-- Date Range Filter Form -->
        <div class="card-body bg-light border-bottom p-4 no-print">
            <form id="billFilterForm" asp-action="AppointmentReports" method="post">
                <div class="row align-items-end g-3 justify-content-center">
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-dark">From Date</label>
                        <div class="input-group">
                            <input type="text" id="fromDate" name="fromDate" class="form-control" placeholder="Select Start Date" style="border-radius: 8px 0 0 8px;" required />
                            <span class="input-group-text bg-white" id="fromDateIcon"><i class="fa fa-calendar text-primary"></i></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-dark">To Date</label>
                        <div class="input-group">
                            <input type="text" id="toDate" name="toDate" class="form-control" placeholder="Select End Date" style="border-radius: 8px 0 0 8px;" required />
                            <span class="input-group-text bg-white" id="toDateIcon"><i class="fa fa-calendar text-primary"></i></span>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1" style="border-radius: 30px; height: 42px; font-weight: 700; background-color: #805ad5; border: none;">
                            <i class="fas fa-filter me-1"></i> Filter
                        </button>
                        <a class="btn btn-outline-secondary" asp-controller="Report" asp-action="AppointmentReport" title="Reset Filters" style="border-radius: 30px; height: 42px; width: 42px; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="fa fa-sync-alt"></i>
                        </a>
                        <button type="button" class="btn btn-warning text-white" onclick="loadAndPrint()" title="Print Report" style="border-radius: 30px; height: 42px; background-color: #ed8936; border: none; font-weight: 700; padding: 0 1.25rem;">
                            <i class="fa fa-print me-1"></i> Print
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Summary KPI Card -->
        @if (Model != null && Model.Any())
        {
            <div class="card-body border-bottom p-4">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                            <div class="p-3 bg-purple text-white rounded-3 fs-4" style="background-color: #805ad5;">
                                <i class="fas fa-calendar-check"></i>
                            </div>
                            <div>
                                <div class="text-muted small fw-bold uppercase">Total Appointments</div>
                                <div class="fs-4 fw-bold text-dark">@totalCount</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Report Table -->
        <div class="card-body p-4">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;">Sl No</th>
                                <th>Appointment Date</th>
                                <th>Serial No</th>
                                <th>Patient Name</th>
                                <th>Phone Number</th>
                                <th>Reported Problem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int count = 1; }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@count</td>
                                    <td style="font-family: monospace;">@(item.AppoinmentDate?.ToString("dd-MM-yyyy") ?? "N/A")</td>
                                    <td><span class="badge bg-secondary">#@item.SerialNumber</span></td>
                                    <td style="font-weight: 700; color: #2d3748;">@item.PatientName</td>
                                    <td style="font-family: monospace; color: #4a5568;">@item.PatientPhoneNumber</td>
                                    <td class="text-muted">@(item.Problem ?? "General Checkup")</td>
                                </tr>
                                count++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-search fs-1 text-secondary mb-3 d-block"></i>
                    <h5>No Appointment Records Found</h5>
                    <p class="mb-0">Select a date range above and click <strong>Filter</strong> to view appointments.</p>
                </div>
            }
        </div>

    </div>
</div>

<div id="printContainer" style="display:none;"></div>

<script>
    $(function () {
        var today = new Date();
        var firstDateOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        var lastDateOfMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        $("#fromDate").datepicker({
            dateFormat: "dd-mm-yy",
            changeMonth: true,
            changeYear: true
        }).datepicker("setDate", firstDateOfMonth);

        $("#toDate").datepicker({
            dateFormat: "dd-mm-yy",
            changeMonth: true,
            changeYear: true
        }).datepicker("setDate", lastDateOfMonth);

        $("#fromDateIcon").click(function () {
            $("#fromDate").focus();
        });

        $("#toDateIcon").click(function () {
            $("#toDate").focus();
        });
    });

    function loadAndPrint() {
        var fromDate = $('#fromDate').val();
        var toDate = $('#toDate').val();

        if(!fromDate || !toDate){
            alert("Please select From and To date");
            return;
        }

        $.ajax({
            url: '@Url.Action("GetAppointmentReport", "Report")',
            type: 'GET',
            data: { fromDate: fromDate, toDate: toDate },
            success: function (data) {
                $('#printContainer').html(data);
                var printContents = document.getElementById('printContainer').innerHTML;
                var originalContents = document.body.innerHTML;

                document.body.innerHTML = printContents;
                window.print();
                document.body.innerHTML = originalContents;
                location.reload();
            },
            error: function () {
                alert("Failed to load print view.");
            }
        });
    }
</script>