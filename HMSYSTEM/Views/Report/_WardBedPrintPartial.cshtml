@model List<HMSYSTEM.ViewModels.WardBedViewModel>

@{
    int totalBeds = Model != null ? Model.Count : 0;
    int occupiedCount = Model != null ? Model.Count(m => m.IsOccupied) : 0;
    int availableCount = Model != null ? Model.Count(m => !m.IsOccupied) : 0;
    double occupancyRate = totalBeds > 0 ? Math.Round((double)occupiedCount / totalBeds * 100, 1) : 0;
}

<style type="text/css">
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 10mm;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 10pt;
            color: #000000;
            background: #ffffff !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        #WardBedPrintArea {
            width: 100% !important;
            max-width: 210mm !important;
            margin: 0 auto !important;
            padding: 0 !important;
            box-shadow: none !important;
            border: none !important;
        }

        button, .btn, .no-print, .app-header, .app-sidebar, .app-footer {
            display: none !important;
        }
    }

    #WardBedPrintArea {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #2d3748;
        background: #ffffff;
        padding: 1.5rem;
        max-width: 210mm;
        margin: 0 auto;
    }

    .report-print-header {
        border-bottom: 2px solid #2b6cb0;
        padding-bottom: 1rem;
        margin-bottom: 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .hospital-info-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: #2b6cb0;
        margin: 0;
    }

    .hospital-info-sub {
        font-size: 0.85rem;
        color: #4a5568;
        margin: 2px 0 0 0;
    }

    .report-title-badge {
        background-color: #ebf8ff;
        color: #2b6cb0;
        border: 1px solid #bee3f8;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .generated-date {
        font-size: 0.75rem;
        color: #718096;
        text-align: right;
        margin-top: 4px;
    }

    .stats-summary-bar {
        display: flex;
        gap: 15px;
        margin-bottom: 1.25rem;
        background: #f7fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 12px 16px;
    }

    .stat-item {
        flex: 1;
        text-align: center;
    }

    .stat-item-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: #718096;
        text-transform: uppercase;
    }

    .stat-item-val {
        font-size: 1.2rem;
        font-weight: 800;
        color: #2d3748;
    }

    .print-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 0.5rem;
    }

    .print-table th {
        background-color: #f7fafc !important;
        color: #2d3748 !important;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        padding: 8px 12px;
        border: 1px solid #cbd5e0;
    }

    .print-table td {
        padding: 8px 12px;
        font-size: 0.85rem;
        border: 1px solid #e2e8f0;
        color: #2d3748;
    }

    .status-badge-occupied {
        color: #c53030;
        font-weight: 700;
    }

    .status-badge-available {
        color: #2f855a;
        font-weight: 700;
    }
</style>

<div id="WardBedPrintArea">

    <!-- Standardized Hospital Header -->
    <div class="report-print-header">
        <div>
            <h2 class="hospital-info-title">HMS Hospital Management</h2>
            <p class="hospital-info-sub">Charghat, Rajshahi • Mobile: 01791177192</p>
        </div>
        <div>
            <div class="report-title-badge">
                Ward & Bed Occupancy Report
            </div>
            <div class="generated-date">
                Generated: @DateTime.Now.ToString("dd-MM-yyyy hh:mm tt")
            </div>
        </div>
    </div>

    <!-- Summary Stats -->
    <div class="stats-summary-bar">
        <div class="stat-item">
            <div class="stat-item-label">Total Beds</div>
            <div class="stat-item-val">@totalBeds</div>
        </div>
        <div class="stat-item" style="border-left: 1px solid #e2e8f0;">
            <div class="stat-item-label">Occupied Beds</div>
            <div class="stat-item-val" style="color: #c53030;">@occupiedCount</div>
        </div>
        <div class="stat-item" style="border-left: 1px solid #e2e8f0;">
            <div class="stat-item-label">Available Beds</div>
            <div class="stat-item-val" style="color: #2f855a;">@availableCount</div>
        </div>
        <div class="stat-item" style="border-left: 1px solid #e2e8f0;">
            <div class="stat-item-label">Occupancy Rate</div>
            <div class="stat-item-val" style="color: #2b6cb0;">@occupancyRate%</div>
        </div>
    </div>

    <!-- Data Table -->
    <table class="print-table">
        <thead>
            <tr>
                <th style="width: 220px;">Ward Name</th>
                <th style="width: 50px; text-align: center;">Sl</th>
                <th style="width: 140px;">Bed Number</th>
                <th style="width: 140px; text-align: center;">Occupancy Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var wardGroup in Model.GroupBy(m => m.WardName))
                {
                    var beds = wardGroup.ToList();
                    for (int i = 0; i < beds.Count; i++)
                    {
                        <tr>
                            @if (i == 0)
                            {
                                <td rowspan="@beds.Count" style="font-weight: 700; background: #ffffff; vertical-align: middle; color: #2b6cb0;">
                                    🏥 @wardGroup.Key
                                </td>
                            }
                            <td style="text-align: center;">@(i + 1)</td>
                            <td style="font-weight: 700;">🛏️ @beds[i].BedNumber</td>
                            <td style="text-align: center;">
                                @if (beds[i].IsOccupied)
                                {
                                    <span class="status-badge-occupied">🔒 Occupied</span>
                                }
                                else
                                {
                                    <span class="status-badge-available">✓ Available</span>
                                }
                            </td>
                        </tr>
                    }
                }
            }
            else
            {
                <tr>
                    <td colspan="4" style="text-align: center; color: #718096; padding: 20px;">
                        No ward or bed records found.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
