@using HMSYSTEM.Enum
@using HMSYSTEM.Models
@{
    ViewData["Title"] = "Ward Management";
    var departments = ViewBag.Department as IEnumerable<Department> ?? new List<Department>();
    var wardTypes = Enum.GetValues(typeof(WardType)).Cast<WardType>();
}

<!-- Premium Modern Styles for Ward Index -->
<style>
    .ward-card {
        border: none !important;
        border-radius: 16px !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important;
        background: #ffffff;
        overflow: hidden;
    }

    .ward-card-header {
        background: #ffffff !important;
        border-bottom: 1px solid #f1f2f6 !important;
        padding: 1.5rem 2rem !important;
    }

    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .header-title-block {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .header-icon {
        width: 44px;
        height: 44px;
        background: rgba(49, 130, 206, 0.1);
        color: #3182ce;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .ward-card-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #2d3748;
        margin: 0;
    }

    .ward-card-subtitle {
        font-size: 0.82rem;
        color: #718096;
        margin: 2px 0 0 0;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    /* Search Input Custom Design */
    .search-wrapper {
        position: relative;
        min-width: 260px;
    }

    .search-wrapper .search-icon {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #a0aec0;
        font-size: 0.95rem;
        pointer-events: none;
    }

    .search-wrapper input.search-control {
        padding-left: 50px !important;
        padding-right: 15px !important;
        border-radius: 30px !important;
        border: 1.5px solid #e2e8f0 !important;
        font-size: 0.9rem !important;
        height: 42px !important;
        transition: all 0.3s ease !important;
        box-shadow: none !important;
        background-color: #f7fafc !important;
    }

    .search-wrapper input.search-control:focus {
        border-color: #3182ce !important;
        background-color: #ffffff !important;
        box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.15) !important;
    }

    /* Create Button Custom Design */
    .btn-gradient-create {
        background: linear-gradient(135deg, #3182ce 0%, #2b6cb0 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 30px !important;
        padding: 0 1.5rem !important;
        font-weight: 700 !important;
        font-size: 0.9rem !important;
        height: 42px !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(49, 130, 206, 0.3) !important;
        transition: all 0.3s ease !important;
        cursor: pointer;
        text-decoration: none !important;
    }

    .btn-gradient-create:hover {
        transform: translateY(-1.5px);
        box-shadow: 0 6px 20px rgba(49, 130, 206, 0.4) !important;
        color: #ffffff !important;
    }

    .btn-gradient-create:active {
        transform: translateY(0);
    }

    /* Custom Table Design */
    .table-container {
        padding: 1rem 1.5rem !important;
    }

    #wardTable {
        border-collapse: separate !important;
        border-spacing: 0 !important;
        width: 100% !important;
        border: none !important;
    }

    #wardTable th {
        background-color: #f7fafc !important;
        color: #4a5568 !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        font-size: 0.75rem !important;
        letter-spacing: 0.8px !important;
        padding: 16px 20px !important;
        border-bottom: 2px solid #edf2f7 !important;
        border-top: none !important;
    }

    #wardTable td {
        padding: 16px 20px !important;
        vertical-align: middle !important;
        border-bottom: 1px solid #edf2f7 !important;
        color: #2d3748 !important;
        font-size: 0.9rem !important;
    }

    #wardTable tbody tr {
        transition: background-color 0.2s ease;
    }

    #wardTable tbody tr:hover {
        background-color: #f7fafc !important;
    }

    /* Action Buttons Group */
    .action-btn-group {
        display: flex;
        justify-content: center;
        gap: 8px;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        text-decoration: none !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 0.9rem;
        border: 1px solid transparent;
    }

    .action-edit {
        background-color: #ebf8ff;
        color: #2b6cb0;
        border-color: #bee3f8;
    }

    .action-edit:hover {
        background-color: #3182ce;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(49, 130, 206, 0.2);
    }

    .action-delete {
        background-color: #fff5f5;
        color: #c53030;
        border-color: #fed7d7;
    }

    .action-delete:hover {
        background-color: #e53e3e;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(229, 62, 62, 0.2);
    }

    .btn-show-beds {
        background-color: #e2e8f0;
        color: #2d3748;
        border: 1px solid #cbd5e0;
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 0.82rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .btn-show-beds:hover {
        background-color: #3182ce;
        color: #ffffff;
        border-color: #3182ce;
        box-shadow: 0 4px 10px rgba(49, 130, 206, 0.25);
    }

    /* Modal Styling */
    .modal-content {
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15) !important;
        overflow: hidden;
    }

    .modal-header {
        background: linear-gradient(135deg, #ed8936 0%, #dd6b20 100%) !important;
        color: #ffffff !important;
        border: none !important;
        padding: 1.5rem !important;
    }

    .modal-title {
        font-weight: 800;
        letter-spacing: 0.5px;
    }

    .modal-header .btn-close {
        filter: brightness(0) invert(1);
    }

    .modal-body {
        padding: 2rem !important;
    }

    .modal-footer {
        border-top: 1px solid #edf2f7 !important;
        padding: 1.25rem 2rem !important;
        background-color: #f7fafc;
    }

    .form-label {
        font-weight: 700;
        color: #4a5568;
        font-size: 0.85rem;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        border-radius: 8px !important;
        border: 1.5px solid #e2e8f0 !important;
        padding: 10px 14px !important;
        font-size: 0.9rem !important;
        transition: all 0.25s ease !important;
        background-color: #fcfdfe;
    }

    .form-control:focus, .form-select:focus {
        border-color: #3182ce !important;
        background-color: #ffffff !important;
        box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.12) !important;
    }

    .btn-save {
        background-color: #dd6b20 !important;
        border: none !important;
        border-radius: 30px !important;
        color: #ffffff !important;
        padding: 0.6rem 2rem !important;
        font-weight: 700 !important;
        box-shadow: 0 4px 10px rgba(221, 107, 32, 0.3) !important;
        transition: all 0.25s ease !important;
    }

    .btn-save:hover {
        background-color: #c05621 !important;
        transform: translateY(-1px);
        box-shadow: 0 6px 15px rgba(221, 107, 32, 0.4) !important;
        color: #ffffff !important;
    }

    .btn-close-modal {
        border-radius: 30px !important;
        padding: 0.6rem 2rem !important;
        font-weight: 700 !important;
        transition: all 0.25s ease !important;
    }

    /* Toastr Custom Design Overrides */
    #toast-container > .toast-success {
        background-color: #2f855a !important;
        color: #ffffff !important;
        opacity: 1 !important;
        box-shadow: 0 4px 14px rgba(47, 133, 90, 0.3) !important;
    }
    #toast-container > .toast-error {
        background-color: #c53030 !important;
        color: #ffffff !important;
        opacity: 1 !important;
        box-shadow: 0 4px 14px rgba(197, 48, 48, 0.3) !important;
    }
    #toast-container > .toast {
        background-image: none !important;
        padding: 15px 20px 15px 50px !important;
        border-radius: 10px !important;
        border: none !important;
    }
    #toast-container .toast-message,
    #toast-container .toast-title {
        color: #ffffff !important;
        font-weight: 600 !important;
    }
</style>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card ward-card mb-4">
                
                <!-- Card Header -->
                <div class="card-header ward-card-header">
                    <div class="header-container">
                        <div class="header-title-block">
                            <div class="header-icon">
                                <i class="fas fa-hospital-alt"></i>
                            </div>
                            <div>
                                <h3 class="ward-card-title">Existing Ward List</h3>
                                <p class="ward-card-subtitle">Manage and monitor hospital wards, beds, and department allocations.</p>
                            </div>
                        </div>
                        <div class="header-actions">
                            <div class="d-flex align-items-center gap-2">
                                <div class="search-wrapper">
                                    <i class="fas fa-search search-icon"></i>
                                    <input type="text" class="form-control search-control" placeholder="Search Ward..." id="searchBox" />
                                </div>
                                <button type="button" class="btn btn-primary" id="btnSearch" style="border-radius: 30px; height: 42px; padding: 0 1.5rem; font-weight: 700; background-color: #3182ce; border-color: #3182ce; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 14px rgba(49, 130, 206, 0.25);">
                                    <i class="fas fa-search"></i> Search
                                </button>
                            </div>
                            <button type="button" class="btn btn-gradient-create" data-bs-toggle="modal" data-bs-target="#addWardModal">
                                <i class="fas fa-plus me-2"></i> Create
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Table Body -->
                <div class="card-body table-container">
                    <table id="wardTable" class="table table-hover">
                        <thead>
                            <tr>
                                <th style="width: 70px">Sl No</th>
                                <th>Ward Name</th>
                                <th>Type</th>
                                <th>Department</th>
                                <th>Floor No</th>
                                <th>Total Beds</th>
                                <th style="text-align: center">Bed Status</th>
                                <th style="width: 120px; text-align: center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="wardBody">
                            <!-- Dynamic Content Via AJAX -->
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                <div class="card-footer" style="background-color: #ffffff; border-top: 1px solid #f1f2f6; padding: 1.25rem 2rem;">
                    <div class="row align-items-center">
                        <div class="col-sm-6 text-center text-sm-start mb-3 mb-sm-0">
                            <div class="text-muted" style="font-size: 0.85rem;">
                                Showing page <span id="cpage" class="fw-bold text-dark">0</span> of <span id="tpage" class="fw-bold text-dark">0</span> (<span id="tentries" class="fw-bold text-dark">0</span> total entries)
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <nav aria-label="Page navigation" class="d-flex justify-content-center justify-content-sm-end">
                                <ul class="pagination pagination-sm m-0" style="gap: 5px;">
                                    <li class="page-item" id="prevLi">
                                        <a id="btnPrevious" class="page-link" href="javascript:void(0);" style="border-radius: 30px !important; padding: 6px 18px; font-weight: 700; color: #4a5568; border-color: #e2e8f0; transition: all 0.2s ease;">⬅️ Previous</a>
                                    </li>
                                    <li class="page-item" id="nextLi">
                                        <a id="btnNext" class="page-link" href="javascript:void(0);" style="border-radius: 30px !important; padding: 6px 18px; font-weight: 700; color: #4a5568; border-color: #e2e8f0; transition: all 0.2s ease;">Next ➡️</a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Add Ward Modal -->
<div class="modal fade" id="addWardModal" tabindex="-1" aria-labelledby="addWardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addWardModalLabel">
                    <i class="fas fa-hospital-alt me-2"></i> Ward Information
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Ward" asp-action="Save" method="post" id="addWardForm">
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="Name" class="form-label">Ward Name</label>
                            <input name="Name" id="Name" class="form-control" placeholder="e.g. ICU Ward A" required />
                        </div>
                        <div class="col-md-6">
                            <label for="FloorNo" class="form-label">Floor No</label>
                            <input name="FloorNo" id="FloorNo" class="form-control" placeholder="e.g. 3rd Floor" required />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="Type" class="form-label">Ward Type</label>
                            <select name="Type" id="Type" class="form-select" required>
                                <option value="">-- Select Ward Type --</option>
                                @foreach (var type in wardTypes)
                                {
                                    <option value="@(Convert.ToInt32(type))">@type</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="DepartmentId" class="form-label">Department</label>
                            <select name="DepartmentId" id="DepartmentId" class="form-select" required>
                                <option value="">-- Select Department --</option>
                                @foreach (var dept in departments)
                                {
                                    <option value="@dept.DepartmentId">@dept.DepartmentName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="TotalBeds" class="form-label">Total Beds</label>
                            <input name="TotalBeds" id="TotalBeds" class="form-control" type="number" min="1" placeholder="e.g. 10" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-center">
                    <button type="submit" class="btn btn-save">
                        <i class="fas fa-save me-2"></i> Save
                    </button>
                    <button type="button" class="btn btn-secondary btn-close-modal" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i> Close
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Ward Modal -->
<div class="modal fade" id="editWardModal" tabindex="-1" aria-labelledby="editWardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #3182ce 0%, #2b6cb0 100%) !important; color: #ffffff !important;">
                <h5 class="modal-title" id="editWardModalLabel">
                    <i class="fas fa-edit me-2"></i> Edit Ward Information
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: brightness(0) invert(1);"></button>
            </div>
            <form asp-controller="Ward" asp-action="Update" method="post" id="editWardForm">
                <input type="hidden" name="Id" id="editWardId" />
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editName" class="form-label">Ward Name</label>
                            <input name="Name" id="editName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label for="editFloorNo" class="form-label">Floor No</label>
                            <input name="FloorNo" id="editFloorNo" class="form-control" required />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editType" class="form-label">Ward Type</label>
                            <select name="Type" id="editType" class="form-select" required>
                                <option value="">-- Select Ward Type --</option>
                                @foreach (var type in wardTypes)
                                {
                                    <option value="@(Convert.ToInt32(type))">@type</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editDepartmentId" class="form-label">Department</label>
                            <select name="DepartmentId" id="editDepartmentId" class="form-select" required>
                                <option value="">-- Select Department --</option>
                                @foreach (var dept in departments)
                                {
                                    <option value="@dept.DepartmentId">@dept.DepartmentName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editTotalBeds" class="form-label">Total Beds</label>
                            <input name="TotalBeds" id="editTotalBeds" class="form-control" type="number" min="1" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-center">
                    <button type="submit" class="btn btn-save" style="background-color: #3182ce !important; box-shadow: 0 4px 10px rgba(49, 130, 206, 0.3) !important;">
                        <i class="fas fa-save me-2"></i> Update
                    </button>
                    <button type="button" class="btn btn-secondary btn-close-modal" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i> Close
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bed Status Modal -->
<div class="modal fade" id="bedModal" tabindex="-1" aria-labelledby="bedModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #4a5568 0%, #2d3748 100%) !important; color: #ffffff !important;">
                <h5 class="modal-title" id="bedModalLabel">
                    <i class="fas fa-bed me-2"></i> Beds Info
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: brightness(0) invert(1);"></button>
            </div>
            <div class="modal-body" id="bedModalBody" style="padding: 1.5rem;">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted mb-0">Loading bed details...</p>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-center">
                <button type="button" class="btn btn-secondary btn-close-modal" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    var currentPage = 1;
    var totalPages = 1;

    // Helper notification wrappers
    function showSuccess(message) {
        if (typeof toastr !== 'undefined') {
            toastr.success(message);
        } else {
            alert(message);
        }
    }

    function showError(message) {
        if (typeof toastr !== 'undefined') {
            toastr.error(message);
        } else {
            alert(message);
        }
    }

    // Helper function to create row HTML for a ward
    function createrow(index, item) {
        var typeBadgeClass = 'bg-primary';
        if (item.type === 'Emergency') typeBadgeClass = 'bg-danger';
        else if (item.type === 'ICU') typeBadgeClass = 'bg-warning text-dark';
        else if (item.type === 'Cabin') typeBadgeClass = 'bg-info text-dark';

        return `<tr>
            <td>${index}</td>
            <td style="font-weight: 700; color: #2d3748;">${item.name || ''}</td>
            <td><span class="badge ${typeBadgeClass}">${item.type || ''}</span></td>
            <td>${item.departmentName || 'N/A'}</td>
            <td style="font-family: monospace; color: #4a5568;">${item.floorNo || ''}</td>
            <td><span class="badge bg-secondary">${item.totalBeds || 0} Beds</span></td>
            <td style="text-align: center;">
                <button class="btn btn-show-beds" onclick="showBeds(${item.id}, '${item.name.replace(/'/g, "\\'")}')">
                    <i class="fas fa-bed me-1"></i> Show Beds
                </button>
            </td>
            <td>
                <div class="action-btn-group">
                    <a class="action-btn action-edit edit-ward-btn" href="javascript:void(0);" data-id="${item.id}" title="Edit Ward">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a class="action-btn action-delete delete-ward-btn" href="javascript:void(0);" data-id="${item.id}" title="Delete Ward">
                        <i class="fas fa-trash"></i>
                    </a>
                </div>
            </td>
        </tr>`;
    }

    // Function to load wards via AJAX
    function loadWards(page) {
        currentPage = page || 1;

        $("#wardBody").html(`
            <tr>
                <td colspan="8" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted mb-0">Loading wards...</p>
                </td>
            </tr>
        `);

        var searchQuery = $('#searchBox').val() || '';

        $.ajax({
            url: "@Url.Action("GetWard", "Ward")",
            type: "GET",
            data: { search: searchQuery, page: currentPage, pageSize: 10 },
            success: function (response) {
                if (response.issuccess === true) {
                    $("#wardBody").empty();

                    totalPages = response.totalPages || 1;
                    var totalItem = response.totalItem || 0;

                    // Update UI indicators
                    $("#cpage").text(currentPage);
                    $("#tpage").text(totalPages);
                    $("#tentries").text(totalItem);

                    // Update pagination buttons state
                    if (currentPage <= 1) {
                        $("#prevLi").addClass("disabled");
                    } else {
                        $("#prevLi").removeClass("disabled");
                    }

                    if (currentPage >= totalPages) {
                        $("#nextLi").addClass("disabled");
                    } else {
                        $("#nextLi").removeClass("disabled");
                    }

                    if (response.data && response.data.length > 0) {
                        $.each(response.data, function (i, v) {
                            var rowIdx = ((currentPage - 1) * 10) + (i + 1);
                            var row = createrow(rowIdx, v);
                            $("#wardBody").append(row);
                        });
                    } else {
                        $("#wardBody").html(`
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="fas fa-info-circle fs-4"></i>
                                    <p class="mt-2 mb-0">No wards found.</p>
                                </td>
                            </tr>
                        `);
                    }
                } else {
                    $("#wardBody").html(`
                        <tr>
                            <td colspan="8" class="text-center py-4 text-danger">
                                <i class="fas fa-exclamation-triangle fs-4"></i>
                                <p class="mt-2 mb-0">Failed to load ward data.</p>
                            </td>
                        </tr>
                    `);
                }
            },
            error: function (xhr, textStatus, error) {
                $("#wardBody").html(`
                    <tr>
                        <td colspan="8" class="text-center py-4 text-danger">
                            <i class="fas fa-exclamation-triangle fs-4"></i>
                            <p class="mt-2 mb-0">Failed to load data: ${error || xhr.statusText}</p>
                        </td>
                    </tr>
                `);
            }
        });
    }

    function changePage(direction) {
        var targetPage = currentPage + direction;
        if (targetPage >= 1 && targetPage <= totalPages) {
            loadWards(targetPage);
        }
    }

    function showBeds(wardId, wardName) {
        $('#bedModalLabel').html(`<i class="fas fa-bed me-2"></i> Beds in Ward: <b>${wardName}</b>`);
        $('#bedModalBody').html(`
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted mb-0">Loading beds...</p>
            </div>
        `);
        $('#bedModal').modal('show');

        $.ajax({
            url: `@Url.Action("GetBedsByWardId", "Ward")?wardId=${wardId}`,
            type: 'GET',
            success: function (data) {
                if (data.beds && data.beds.length > 0) {
                    let summaryHtml = `
                        <div class="p-3 mb-3" style="background-color: #f7fafc; border-radius: 12px; border: 1px solid #edf2f7;">
                            <strong>Total Beds:</strong> ${data.totalBeds} &nbsp;|&nbsp;
                            <strong class="text-danger">Occupied:</strong> ${data.occupiedBeds} &nbsp;|&nbsp;
                            <strong class="text-success">Available:</strong> ${data.emptyBeds}
                        </div>
                    `;

                    let bedsHtml = '<div class="d-flex flex-wrap gap-2">';
                    bedsHtml += data.beds.map(bed => {
                        let status = bed.isOccupied ? "❌ Unavailable" : "✅ Available";
                        let colorClass = bed.isOccupied ? "bg-danger" : "bg-success";
                        return `<span class="badge ${colorClass} text-light" style="font-size: 0.95rem; padding: 10px 16px; border-radius: 12px; min-width: 200px; display: inline-flex; justify-content: space-between; align-items: center;">
                            <span>🛏️ ${bed.bedNumber}</span> <span>${status}</span>
                        </span>`;
                    }).join('');
                    bedsHtml += '</div>';

                    $('#bedModalBody').html(summaryHtml + bedsHtml);
                } else {
                    $('#bedModalBody').html('<p class="text-muted text-center my-3"><i class="fas fa-info-circle me-1"></i> No beds found in this ward.</p>');
                }
            },
            error: function () {
                $('#bedModalBody').html('<p class="text-danger text-center my-3"><i class="fas fa-exclamation-triangle me-1"></i> Failed to load beds.</p>');
            }
        });
    }

    $(document).ready(function () {
        // Load wards on init
        loadWards(1);

        // Pagination handlers
        $('#btnPrevious').on('click', function (e) {
            e.preventDefault();
            changePage(-1);
        });

        $('#btnNext').on('click', function (e) {
            e.preventDefault();
            changePage(1);
        });

        // Search button click handler
        $('#btnSearch').on('click', function () {
            loadWards(1);
        });

        // Search input Enter keypress
        $('#searchBox').on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                loadWards(1);
            }
        });

        // Handle Add Ward Form Submission via AJAX
        $('#addWardForm').on('submit', function (e) {
            e.preventDefault();
            var form = $(this);
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        showSuccess(response.message);
                        $('#addWardModal').modal('hide');
                        form[0].reset();
                        loadWards(1);
                    } else {
                        showError(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    showError("An error occurred: " + error);
                }
            });
        });

        // Handle Edit Ward Click: Fetch details via AJAX and open modal
        $(document).on('click', '.edit-ward-btn', function () {
            var wardId = $(this).data('id');
            $.getJSON('@Url.Action("GetWardById", "Ward")', { id: wardId }, function (data) {
                $('#editWardId').val(data.id);
                $('#editName').val(data.name);
                $('#editFloorNo').val(data.floorNo);
                $('#editType').val(data.type);
                $('#editDepartmentId').val(data.departmentId);
                $('#editTotalBeds').val(data.totalBeds);
                $('#editWardModal').modal('show');
            }).fail(function () {
                showError("Failed to fetch ward details.");
            });
        });

        // Handle Edit Ward Form Submission via AJAX
        $('#editWardForm').on('submit', function (e) {
            e.preventDefault();
            var form = $(this);
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (response) {
                    if (response.success) {
                        showSuccess(response.message);
                        $('#editWardModal').modal('hide');
                        loadWards(currentPage);
                    } else {
                        showError(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    showError("An error occurred: " + error);
                }
            });
        });

        // Handle Delete Ward Click via AJAX
        $(document).on('click', '.delete-ward-btn', function (e) {
            e.preventDefault();
            var id = $(this).data('id');
            if (confirm("Are you sure you want to delete this ward?")) {
                var clickedBtn = $(this);
                clickedBtn.css('pointer-events', 'none');
                $.ajax({
                    url: '@Url.Action("Delete", "Ward")',
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            showSuccess(response.message);
                            loadWards(currentPage);
                        } else {
                            showError(response.message);
                            clickedBtn.css('pointer-events', 'auto');
                        }
                    },
                    error: function (xhr, status, error) {
                        showError("An error occurred: " + error);
                        clickedBtn.css('pointer-events', 'auto');
                    }
                });
            }
        });
    });
</script>