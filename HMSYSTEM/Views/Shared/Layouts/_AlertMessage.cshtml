<style>

    #saveMessage {
        position: fixed;
        top: 20px;
        right: 20px;
        width: 350px;
        z-index: 1050;
        pointer-events: none; /* span interaction block হবে না */
    }
</style>

@{
    var message = TempData["Message"] as string;
    var messageType = TempData["MessageType"] as string ?? "success";
    if (messageType == "primary") { messageType = "success"; }
    if (messageType == "danger") { messageType = "error"; }
}

@if (!string.IsNullOrEmpty(message))
{
    <script>
        $(document).ready(function () {
            if (typeof toastr !== 'undefined') {
                var type = '@messageType'.toLowerCase();
                var msg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(message));
                if (type === 'danger' || type === 'error') {
                    toastr.error(msg);
                } else if (type === 'warning') {
                    toastr.warning(msg);
                } else if (type === 'info') {
                    toastr.info(msg);
                } else {
                    toastr.success(msg);
                }
            }
        });
    </script>
}

<script>
