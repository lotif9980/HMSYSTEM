@model HMSYSTEM.ViewModels.BillViewModel
@using HMSYSTEM.Helpers
@{
    ViewData["Title"] = "Bill Details";
    var patientName = Model.PatientName ?? "N/A";
}

<!-- Premium Modern Styles for Bill Details -->
<style>
    .details-container {
        max-width: 1050px;
        margin: 2rem auto;
    }

    .details-card {
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.06) !important;
        background: #ffffff;
        overflow: hidden;
    }

    .details-header {
        background: linear-gradient(135deg, #3182ce 0%, #2b6cb0 100%) !important;
        color: #ffffff !important;
        padding: 2rem 2.5rem !important;
        border: none !important;
    }

    .header-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .header-title-block {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-icon-box {
        width: 52px;
        height: 52px;
        background: rgba(255, 255, 255, 0.2);
        color: #ffffff;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        backdrop-filter: blur(5px);
    }

    .header-title {
        font-size: 1.6rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: 0.5px;
    }

    .header-subtitle {
        font-size: 0.9rem;
        opacity: 0.9;
        margin: 3px 0 0 0;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-action-light {
        background: rgba(255, 255, 255, 0.2) !important;
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        border-radius: 30px !important;
        padding: 8px 20px !important;
        font-weight: 700 !important;
        font-size: 0.85rem !important;
        transition: all 0.25s ease !important;
        backdrop-filter: blur(5px);
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-action-light:hover {
        background: #ffffff !important;
        color: #2b6cb0 !important;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15) !important;
    }

    .btn-print {
        background: #ed8936 !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 30px !important;
        padding: 8px 20px !important;
        font-weight: 700 !important;
        font-size: 0.85rem !important;
        box-shadow: 0 4px 12px rgba(237, 137, 54, 0.3) !important;
        transition: all 0.25s ease !important;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-print:hover {
        background: #dd6b20 !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(237, 137, 54, 0.4) !important;
        color: #ffffff !important;
    }

    /* Highlight Summary Banner */
    .summary-banner {
        background: #f7fafc;
        border-bottom: 1px solid #edf2f7;
        padding: 1.25rem 2.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
    }

    .summary-item {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .summary-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #718096;
        font-weight: 700;
    }

    .summary-value {
        font-size: 1rem;
        font-weight: 800;
        color: #2d3748;
    }

    /* Section Cards Grid */
    .details-body {
        padding: 2.5rem !important;
    }

    .info-block-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .info-block-title {
        font-size: 0.95rem;
        font-weight: 800;
        color: #2b6cb0;
        margin-bottom: 1.25rem;
        padding-bottom: 0.6rem;
        border-bottom: 2px solid #ebf8ff;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #edf2f7;
        font-size: 0.9rem;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: #718096;
        font-weight: 600;
    }

    .detail-val {
        color: #2d3748;
        font-weight: 700;
        text-align: right;
    }

    /* Itemized Table */
    .item-table {
        border-collapse: separate !important;
        border-spacing: 0 !important;
        width: 100% !important;
    }

    .item-table th {
        background-color: #f7fafc !important;
        color: #4a5568 !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        font-size: 0.75rem !important;
        letter-spacing: 0.8px !important;
        padding: 14px 18px !important;
        border-bottom: 2px solid #edf2f7 !important;
    }

    .item-table td {
        padding: 14px 18px !important;
        vertical-align: middle !important;
        border-bottom: 1px solid #edf2f7 !important;
        font-size: 0.9rem !important;
    }

    .financial-kpi-card {
        background: #f7fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        text-align: center;
    }

    .words-box {
        background-color: #ebf8ff;
        border-left: 4px solid #3182ce;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        color: #2b6cb0;
        font-size: 0.9rem;
        font-weight: 700;
        margin-top: 1.5rem;
    }
</style>

<div class="container-fluid details-container">
    <div class="card details-card">

        <!-- Header -->
        <div class="card-header details-header">
            <div class="header-top">
                <div class="header-title-block">
                    <div class="header-icon-box">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                    <div>
                        <h2 class="header-title">Patient Bill Invoice</h2>
                        <p class="header-subtitle">Invoice #@(Model.BillNo ?? "N/A") • Billed on @Model.BillDate.ToString("dd MMMM yyyy")</p>
                    </div>
                </div>
                <div class="header-actions">
                    <a class="btn-action-light" asp-controller="Bill" asp-action="Index">
                        <i class="fas fa-arrow-left"></i> Bill List
                    </a>
                    
                    <button type="button" class="btn-print" onclick="loadAndPrint(@Model.Id)">
                        <i class="fas fa-print"></i> Print Invoice
                    </button>
                </div>
            </div>
        </div>

        <!-- Summary Banner -->
        <div class="summary-banner">
            <div class="summary-item">
                <i class="fas fa-user-injured text-primary fs-5 me-1"></i>
                <div>
                    <div class="summary-label">Patient Name</div>
                    <div class="summary-value">@patientName</div>
                </div>
            </div>
            <div class="summary-item">
                <i class="fas fa-file-invoice text-info fs-5 me-1"></i>
                <div>
                    <div class="summary-label">Invoice Number</div>
                    <div class="summary-value">#@(Model.BillNo ?? "N/A")</div>
                </div>
            </div>
            <div class="summary-item">
                <i class="fas fa-coins text-warning fs-5 me-1"></i>
                <div>
                    <div class="summary-label">Net Amount</div>
                    <div class="summary-value text-primary">৳ @((Model.NetAmount ?? 0).ToString("N2"))</div>
                </div>
            </div>
            <div class="summary-item">
                <i class="fas fa-toggle-on text-success fs-5 me-1"></i>
                <div>
                    <div class="summary-label">Status</div>
                    <div class="summary-value">
                        @if (Model.Status == 2)
                        {
                            <span class="badge bg-success" style="padding: 6px 14px; border-radius: 20px;">Paid</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark" style="padding: 6px 14px; border-radius: 20px;">Active / Unpaid</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Body -->
        <div class="card-body details-body">

            <!-- Patient & Invoice Metadata Grid -->
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="info-block-card mb-0">
                        <div class="info-block-title">
                            <i class="fas fa-user me-1"></i> Patient Metadata
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Patient Name</span>
                            <span class="detail-val">@patientName</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Phone Number</span>
                            <span class="detail-val" style="font-family: monospace;">@(Model.PatientPhoneNumber ?? "N/A")</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Address</span>
                            <span class="detail-val">@(Model.Address ?? "N/A")</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-block-card mb-0">
                        <div class="info-block-title">
                            <i class="fas fa-file-alt me-1"></i> Billing Metadata
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Bill Number</span>
                            <span class="detail-val"><span class="badge bg-secondary">#@(Model.BillNo ?? "N/A")</span></span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Bill Date</span>
                            <span class="detail-val">@Model.BillDate.ToString("dd-MM-yyyy")</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Payment Status</span>
                            <span class="detail-val">
                                @if (Model.Status == 2)
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Unpaid</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Itemized Service Details Table -->
            <div class="info-block-card p-0 mb-4 overflow-hidden">
                <div class="p-3 border-bottom bg-light">
                    <h6 class="fw-bold text-dark m-0"><i class="fas fa-list me-2 text-primary"></i> Itemized Service Charges</h6>
                </div>
                <div class="table-responsive">
                    <table class="table item-table table-hover m-0">
                        <thead>
                            <tr>
                                <th style="width: 60px;">Sl No</th>
                                <th>Service Item Name</th>
                                <th>Charge Date</th>
                                <th>Unit Price</th>
                                <th>Qty</th>
                                <th style="text-align: right;">Total Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.BillDetail != null && Model.BillDetail.Any())
                            {
                                int count = 1;
                                foreach (var detail in Model.BillDetail)
                                {
                                    <tr>
                                        <td>@count</td>
                                        <td style="font-weight: 700; color: #2d3748;">@(detail.ItemName ?? "N/A")</td>
                                        <td style="font-family: monospace;">@(detail.ChargeDate?.ToString("dd-MM-yyyy") ?? "N/A")</td>
                                        <td style="font-family: monospace;">৳ @((detail.Amount ?? 0).ToString("N2"))</td>
                                        <td style="font-weight: 600;">@(detail.Qty ?? 1)</td>
                                        <td style="font-family: monospace; font-weight: 700; color: #2b6cb0; text-align: right;">৳ @((detail.TotalAmount ?? 0).ToString("N2"))</td>
                                    </tr>
                                    count++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Financial KPI Summary Grid -->
            <div class="row g-3 mb-4">
                <div class="col-md-2.4 col-sm-4" style="flex: 1;">
                    <div class="financial-kpi-card">
                        <div class="text-muted small fw-bold uppercase">Total Amount</div>
                        <div class="fs-5 fw-bold text-dark mt-1">৳ @((Model.TotalAmount ?? 0).ToString("N2"))</div>
                    </div>
                </div>
                <div class="col-md-2.4 col-sm-4" style="flex: 1;">
                    <div class="financial-kpi-card">
                        <div class="text-muted small fw-bold uppercase">Discount</div>
                        <div class="fs-5 fw-bold text-secondary mt-1">৳ @((Model.Discount ?? 0).ToString("N2"))</div>
                    </div>
                </div>
                <div class="col-md-2.4 col-sm-4" style="flex: 1;">
                    <div class="financial-kpi-card bg-white border-primary">
                        <div class="text-muted small fw-bold uppercase">Net Total</div>
                        <div class="fs-5 fw-bold text-primary mt-1">৳ @((Model.NetAmount ?? 0).ToString("N2"))</div>
                    </div>
                </div>
                <div class="col-md-2.4 col-sm-4" style="flex: 1;">
                    <div class="financial-kpi-card bg-white border-success">
                        <div class="text-muted small fw-bold uppercase">Paid Amount</div>
                        <div class="fs-5 fw-bold text-success mt-1">৳ @((Model.PaymentAmt ?? 0).ToString("N2"))</div>
                    </div>
                </div>
                <div class="col-md-2.4 col-sm-4" style="flex: 1;">
                    <div class="financial-kpi-card bg-white border-danger">
                        <div class="text-muted small fw-bold uppercase">Due Amount</div>
                        <div class="fs-5 fw-bold text-danger mt-1">৳ @((Model.DueAmount ?? 0).ToString("N2"))</div>
                    </div>
                </div>
            </div>

            <!-- Amount in Words Card -->
            <div class="words-box">
                <i class="fas fa-coins me-2"></i> Amount Paid in Words: @QueryableExtensions.TakaInWords(Model.PaymentAmt ?? 0)
            </div>

            <!-- System Disclaimer -->
            <div class="text-center text-danger font-weight-bold mt-4" style="font-size: 0.85rem;">
                [ Note: This is a system-generated invoice and does not require any signature or seal ]
            </div>

        </div>
    </div>
</div>

<div id="printContainer" style="display:none;"></div>

<script>
    function loadAndPrint(id) {
        $.ajax({
            url: '@Url.Action("GetBillPrintPartial", "Bill")/' + id,
            type: 'GET',
            success: function (data) {
                $('#printContainer').html(data);
                var printContents = document.getElementById('printContainer').innerHTML;
                var originalContents = document.body.innerHTML;

                document.body.innerHTML = printContents;
                window.print();
                document.body.innerHTML = originalContents;
                location.reload();
            },
            error: function () {
                alert("Failed to load bill print view.");
            }
        });
    }
</script>
