@model IEnumerable<User>
@using HMSYSTEM.ViewModels
@{
    ViewData["Title"] = "User Management";
}

<!-- Premium Modern Styles for User Index -->
<style>
    .user-card {
        border: none !important;
        border-radius: 16px !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important;
        background: #ffffff;
        overflow: hidden;
    }
    
    .user-card-header {
        background: #ffffff !important;
        border-bottom: 1px solid #f1f2f6 !important;
        padding: 1.5rem 2rem !important;
    }

    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .header-title-block {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .header-icon {
        width: 44px;
        height: 44px;
        background: rgba(49, 130, 206, 0.1);
        color: #3182ce;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .user-card-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #2d3748;
        margin: 0;
    }

    .user-card-subtitle {
        font-size: 0.82rem;
        color: #718096;
        margin: 2px 0 0 0;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    /* Search Input Custom Design */
    .search-wrapper {
        position: relative;
        min-width: 260px;
    }

    .search-wrapper .search-icon {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #a0aec0;
        font-size: 0.95rem;
        pointer-events: none;
    }

    .search-wrapper input.search-control {
        padding-left: 50px !important;
        padding-right: 15px !important;
        border-radius: 30px !important;
        border: 1.5px solid #e2e8f0 !important;
        font-size: 0.9rem !important;
        height: 42px !important;
        transition: all 0.3s ease !important;
        box-shadow: none !important;
        background-color: #f7fafc !important;
    }

    .search-wrapper input.search-control:focus {
        border-color: #3182ce !important;
        background-color: #ffffff !important;
        box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.15) !important;
    }

    /* Create Button Custom Design */
    .btn-gradient-create {
        background: linear-gradient(135deg, #3182ce 0%, #2b6cb0 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 30px !important;
        padding: 0 1.5rem !important;
        font-weight: 700 !important;
        font-size: 0.9rem !important;
        height: 42px !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(49, 130, 206, 0.3) !important;
        transition: all 0.3s ease !important;
        cursor: pointer;
    }

    .btn-gradient-create:hover {
        transform: translateY(-1.5px);
        box-shadow: 0 6px 20px rgba(49, 130, 206, 0.4) !important;
        color: #ffffff !important;
    }

    .btn-gradient-create:active {
        transform: translateY(0);
    }

    /* Custom Table Design */
    .table-container {
        padding: 1rem 1.5rem !important;
    }

    #userTable {
        border-collapse: separate !important;
        border-spacing: 0 !important;
        width: 100% !important;
        border: none !important;
    }

    #userTable th {
        background-color: #f7fafc !important;
        color: #4a5568 !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        font-size: 0.75rem !important;
        letter-spacing: 0.8px !important;
        padding: 16px 20px !important;
        border-bottom: 2px solid #edf2f7 !important;
        border-top: none !important;
    }

    #userTable td {
        padding: 16px 20px !important;
        vertical-align: middle !important;
        border-bottom: 1px solid #edf2f7 !important;
        color: #2d3748 !important;
        font-size: 0.9rem !important;
    }

    #userTable tbody tr {
        transition: background-color 0.2s ease;
    }

    #userTable tbody tr:hover {
        background-color: #f7fafc !important;
    }

    /* Status Badges */
    .status-badge-link {
        text-decoration: none !important;
        display: inline-block;
    }

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.3px;
        transition: all 0.2s ease;
    }

    .status-active {
        background-color: #e6fffa;
        color: #234e52;
        border: 1px solid #b2f5ea;
    }

    .status-active:hover {
        background-color: #b2f5ea;
        transform: scale(1.03);
    }

    .status-inactive {
        background-color: #fff5f5;
        color: #742a2a;
        border: 1px solid #fed7d7;
    }

    .status-inactive:hover {
        background-color: #fed7d7;
        transform: scale(1.03);
    }

    /* Action Buttons Group */
    .action-btn-group {
        display: flex;
        justify-content: center;
        gap: 8px;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        text-decoration: none !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 0.9rem;
        border: 1px solid transparent;
    }

    .action-edit {
        background-color: #ebf8ff;
        color: #2b6cb0;
        border-color: #bee3f8;
    }

    .action-edit:hover {
        background-color: #3182ce;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(49, 130, 206, 0.2);
    }

    .action-delete {
        background-color: #fff5f5;
        color: #c53030;
        border-color: #fed7d7;
    }

    .action-delete:hover {
        background-color: #e53e3e;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(229, 62, 62, 0.2);
    }

    .action-details {
        background-color: #f0fff4;
        color: #2f855a;
        border-color: #c6f6d5;
    }

    .action-details:hover {
        background-color: #38a169;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(56, 161, 105, 0.2);
    }

    /* Modal Styling */
    .modal-content {
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15) !important;
        overflow: hidden;
    }

    .modal-header {
        background: linear-gradient(135deg, #ed8936 0%, #dd6b20 100%) !important;
        color: #ffffff !important;
        border: none !important;
        padding: 1.5rem !important;
    }

    .modal-title {
        font-weight: 800;
        letter-spacing: 0.5px;
    }

    .modal-header .btn-close {
        filter: brightness(0) invert(1);
    }

    .modal-body {
        padding: 2rem !important;
    }

    .modal-footer {
        border-top: 1px solid #edf2f7 !important;
        padding: 1.25rem 2rem !important;
        background-color: #f7fafc;
    }

    .form-label {
        font-weight: 700;
        color: #4a5568;
        font-size: 0.85rem;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        border-radius: 8px !important;
        border: 1.5px solid #e2e8f0 !important;
        padding: 10px 14px !important;
        font-size: 0.9rem !important;
        transition: all 0.25s ease !important;
        background-color: #fcfdfe;
    }

    .form-control:focus, .form-select:focus {
        border-color: #3182ce !important;
        background-color: #ffffff !important;
        box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.12) !important;
    }

    .btn-save {
        background-color: #dd6b20 !important;
        border: none !important;
        border-radius: 30px !important;
        color: #ffffff !important;
        padding: 0.6rem 2rem !important;
        font-weight: 700 !important;
        box-shadow: 0 4px 10px rgba(221, 107, 32, 0.3) !important;
        transition: all 0.25s ease !important;
    }

    .btn-save:hover {
        background-color: #c05621 !important;
        transform: translateY(-1px);
        box-shadow: 0 6px 15px rgba(221, 107, 32, 0.4) !important;
    }

    .btn-close-modal {
        border-radius: 30px !important;
        padding: 0.6rem 2rem !important;
        font-weight: 700 !important;
        transition: all 0.25s ease !important;
    }

    .dataTables_length select {
        padding: 6px 30px 6px 12px !important;
        border-radius: 8px !important;
        border: 1.5px solid #e2e8f0 !important;
        font-size: 0.85rem !important;
        background-color: #f7fafc !important;
    }

    /* Toastr Custom Design Overrides to fix white text visibility */
    #toast-container > .toast-success {
        background-color: #2f855a !important; /* Solid Premium Green */
        color: #ffffff !important;
        opacity: 1 !important;
        box-shadow: 0 4px 14px rgba(47, 133, 90, 0.3) !important;
    }
    #toast-container > .toast-error {
        background-color: #c53030 !important; /* Solid Premium Red */
        color: #ffffff !important;
        opacity: 1 !important;
        box-shadow: 0 4px 14px rgba(197, 48, 48, 0.3) !important;
    }
    #toast-container > .toast {
        background-image: none !important;
        padding: 15px 20px 15px 50px !important;
        border-radius: 10px !important;
        border: none !important;
    }
    #toast-container .toast-message,
    #toast-container .toast-title {
        color: #ffffff !important;
        font-weight: 600 !important;
    }

    /* Pagination Styles */
    .pagination .page-link {
        box-shadow: none !important;
    }
    
    .pagination .page-item:not(.disabled) .page-link:hover {
        background-color: #3182ce !important;
        color: #ffffff !important;
        border-color: #3182ce !important;
    }
    
    .pagination .page-item.disabled .page-link {
        color: #a0aec0 !important;
        background-color: #f7fafc !important;
        border-color: #edf2f7 !important;
        pointer-events: none;
    }
</style>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card user-card mb-4">
                
                <!-- Beautiful Card Header -->
                <div class="card-header user-card-header">
                    <div class="header-container">
                        <div class="header-title-block">
                            <div class="header-icon">
                                <i class="fas fa-users-cog"></i>
                            </div>
                            <div>
                                <h3 class="user-card-title">Existing User List</h3>
                                <p class="user-card-subtitle">Manage and monitor application user roles and statuses.</p>
                            </div>
                        </div>
                        <div class="header-actions">
                            <div class="d-flex align-items-center gap-2">
                                <div class="search-wrapper" style="position: relative; min-width: 240px;">
                                    <i class="fas fa-search search-icon" style="position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: #a0aec0; font-size: 0.95rem; pointer-events: none; z-index: 5;"></i>
                                    <input type="text" class="form-control search-control" placeholder="Search Name..." id="searchBox" style="padding-left: 50px !important; padding-right: 15px !important; border-radius: 30px !important; border: 1.5px solid #e2e8f0 !important; font-size: 0.9rem !important; height: 42px !important; transition: all 0.3s ease !important; box-shadow: none !important; background-color: #f7fafc !important;" />
                                </div>
                                <button type="button" class="btn btn-primary" id="btnSearch" style="border-radius: 30px; height: 42px; padding: 0 1.5rem; font-weight: 700; background-color: #3182ce; border-color: #3182ce; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 14px rgba(49, 130, 206, 0.25);">
                                    <i class="fas fa-search"></i> Search
                                </button>
                            </div>
                            <button type="button" class="btn btn-gradient-create" data-bs-toggle="modal" data-bs-target="#addUserModal">
                                <i class="fas fa-user-plus me-2"></i> Create
                            </button>
                        </div>
                    </div>
                </div>

                <!-- /.card-header -->
                <div class="card-body table-container">
                    <table id="userTable" class="table table-hover">
                        <thead>
                            <tr>
                                <th style="width:80px">Sl No</th>
                                <th>Name</th>
                                <th>Mobile No </th>
                                <th>User Name </th>
                                <th style="text-align:center">Status</th>
                                <th style="width:120px;text-align:center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="dataShow">
                            <!-- Populated dynamically via AJAX -->
                        </tbody>
                    </table>
                </div>
                <!-- Pagination Footer -->
                <div class="card-footer" style="background-color: #ffffff; border-top: 1px solid #f1f2f6; padding: 1.25rem 2rem;">
                    <div class="row align-items-center">
                        <div class="col-sm-6 text-center text-sm-start mb-3 mb-sm-0">
                            <div class="text-muted" style="font-size: 0.85rem;">
                                Showing page <span id="cpage" class="fw-bold text-dark">0</span> of <span id="tpage" class="fw-bold text-dark">0</span> (<span id="tentries" class="fw-bold text-dark">0</span> total entries)
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <nav aria-label="Page navigation" class="d-flex justify-content-center justify-content-sm-end">
                                <ul class="pagination pagination-sm m-0" style="gap: 5px;">
                                    <li class="page-item" id="prevLi">
                                        <a id="btnPrevious" class="page-link" href="javascript:void(0);" style="border-radius: 30px !important; padding: 6px 18px; font-weight: 700; color: #4a5568; border-color: #e2e8f0; transition: all 0.2s ease;">⬅️ Previous</a>
                                    </li>
                                    <li class="page-item" id="nextLi">
                                        <a id="btnNext" class="page-link" href="javascript:void(0);" style="border-radius: 30px !important; padding: 6px 18px; font-weight: 700; color: #4a5568; border-color: #e2e8f0; transition: all 0.2s ease;">Next ➡️</a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
                <!-- /.card-body -->
                
            </div>
            <!-- /.card -->
        </div>
    </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addUserModalLabel">
                    <i class="fas fa-user-shield me-2"></i> User Information
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="User" asp-action="Save" method="post" id="addUserForm">
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="Name" class="form-label">Name</label>
                            <input name="Name" id="Name" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label for="MobileNo" class="form-label">Mobile No</label>
                            <input name="MobileNo" id="MobileNo" class="form-control" type="number" required />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="UserName" class="form-label">User Name</label>
                            <input name="UserName" id="UserName" class="form-control" required autocomplete="off" />
                        </div>
                        <div class="col-md-6">
                            <label for="Password" class="form-label">Password</label>
                            <input name="Password" id="Password" class="form-control" type="password" required autocomplete="off" />
                        </div>
                    </div>

                    <div class="row mb-3 align-items-end">
                        <div class="col-md-6">
                            <label for="RoleId" class="form-label">Role</label>
                            <select name="RoleId" id="modalRoleId" class="form-control" required>
                                <option value="">--Select Role--</option>
                                @if (ViewBag.Roles != null)
                                {
                                    foreach (var item in ViewBag.Roles)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="isDoctorCheckbox">
                                <label class="form-check-label" for="isDoctorCheckbox" style="font-weight: 700; color: #4a5568;">
                                    Is Doctor?
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3" id="doctorFieldsRow" style="display: none;">
                        <div class="col-md-6">
                            <label for="DepartmentId" class="form-label">Department</label>
                            <select id="modalDepartmentId" class="form-control">
                                <option value="">--Select Department--</option>
                                @if (ViewBag.Departments != null)
                                {
                                    foreach (var item in ViewBag.Departments)
                                    {
                                        <option value="@item.DepartmentId">@item.DepartmentName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="DoctorId" class="form-label">Doctor Name</label>
                            <select name="DoctorId" id="modalDoctorId" class="form-control">
                                <option value="0">--Select Doctor--</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-center">
                    <button type="submit" class="btn btn-save">
                        <i class="fas fa-save me-2"></i> Save 
                    </button>
                    <button type="button" class="btn btn-secondary btn-close-modal" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i> Close
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #3182ce 0%, #2b6cb0 100%) !important; color: #ffffff !important;">
                <h5 class="modal-title" id="editUserModalLabel">
                    <i class="fas fa-user-edit me-2"></i> Edit User Information
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: brightness(0) invert(1);"></button>
            </div>
            <form asp-controller="User" asp-action="Update" method="post" id="editUserForm">
                <input type="hidden" name="Id" id="editUserId" />
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editName" class="form-label">Name</label>
                            <input name="Name" id="editName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label for="editMobileNo" class="form-label">Mobile No</label>
                            <input name="MobileNo" id="editMobileNo" class="form-control" type="number" required />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editUserName" class="form-label">User Name</label>
                            <input name="UserName" id="editUserName" class="form-control" required autocomplete="off" />
                        </div>
                        <div class="col-md-6">
                            <label for="editRoleId" class="form-label">Role</label>
                            <select name="RoleId" id="editRoleId" class="form-control" required>
                                <option value="">--Select Role--</option>
                                @if (ViewBag.Roles != null)
                                {
                                    foreach (var item in ViewBag.Roles)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3 align-items-end">
                        <div class="col-md-6">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="editIsDoctorCheckbox">
                                <label class="form-check-label" for="editIsDoctorCheckbox" style="font-weight: 700; color: #4a5568;">
                                    Is Doctor?
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3" id="editDoctorFieldsRow" style="display: none;">
                        <div class="col-md-6">
                            <label for="editDepartmentId" class="form-label">Department</label>
                            <select id="editDepartmentId" class="form-control">
                                <option value="">--Select Department--</option>
                                @if (ViewBag.Departments != null)
                                {
                                    foreach (var item in ViewBag.Departments)
                                    {
                                        <option value="@item.DepartmentId">@item.DepartmentName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editDoctorId" class="form-label">Doctor Name</label>
                            <select name="DoctorId" id="editDoctorId" class="form-control">
                                <option value="0">--Select Doctor--</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-center">
                    <button type="submit" class="btn btn-save" style="background-color: #3182ce !important; box-shadow: 0 4px 10px rgba(49, 130, 206, 0.3) !important;">
                        <i class="fas fa-save me-2"></i> Update
                    </button>
                    <button type="button" class="btn btn-secondary btn-close-modal" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i> Close
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    var currentPage = 1;
    var totalPages = 1;

    // Helper notification wrappers in case toastr is not loaded correctly
    function showSuccess(message) {
        if (typeof toastr !== 'undefined') {
            toastr.success(message);
        } else {
            alert(message);
        }
    }

    // Helper notification wrappers
    function showError(message) {
        if (typeof toastr !== 'undefined') {
            toastr.error(message);
        } else {
            alert(message);
        }
    }

    // Helper function to create row HTML for a user
    function createrow(index, item) {
        var statusBadge = item.status === true 
            ? `<span class="badge-status status-active"><i class="fas fa-check-circle me-2"></i>Active</span>`
            : `<span class="badge-status status-inactive"><i class="fas fa-times-circle me-2"></i>Inactive</span>`;
            
        return `<tr>
            <td>${index}</td>
            <td style="font-weight:700; color:#2d3748;">${item.name || ''}</td>
            <td>${item.mobileNo || ''}</td>
            <td style="font-family:monospace; color:#4a5568;">${item.userName || ''}</td>
            <td style="text-align:center">
                <a href="javascript:void(0);" data-id="${item.id}" class="status-badge-link toggle-status-btn">
                    ${statusBadge}
                </a>
            </td>
            <td>
                <div class="action-btn-group">
                    <a class="action-btn action-edit edit-user-btn" href="javascript:void(0);" data-id="${item.id}" title="Edit User">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a class="action-btn action-delete delete-user-btn" href="javascript:void(0);" data-id="${item.id}" title="Delete User">
                        <i class="fas fa-trash"></i>
                    </a>
                </div>
            </td>
        </tr>`;
    }

    // Function to load users via AJAX and update #dataShow directly
    function loadUsers(page) {
        currentPage = page || 1;

        $("#dataShow").html(`
            <tr>
                <td colspan="6" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted mb-0">Loading users...</p>
                </td>
            </tr>
        `);

        var searchQuery = $('#searchBox').val() || '';

        $.ajax({
            url: "@Url.Action("GetUsersJson", "User")",
            type: "GET",
            data: {
                search: searchQuery,
                page: currentPage,
                pageSize: 10
            },
            dataType: "json",
            cache: false,
            success: function (response) {
                if (response.issuccess === true) {
                    $("#dataShow").empty();

                    totalPages = response.totalPages || 1;
                    var totalItem = response.totalItem || 0;

                    // Update UI indicators
                    $("#cpage").text(currentPage);
                    $("#tpage").text(totalPages);
                    $("#tentries").text(totalItem);

                    // Update pagination buttons state
                    if (currentPage <= 1) {
                        $("#prevLi").addClass("disabled");
                    } else {
                        $("#prevLi").removeClass("disabled");
                    }

                    if (currentPage >= totalPages) {
                        $("#nextLi").addClass("disabled");
                    } else {
                        $("#nextLi").removeClass("disabled");
                    }

                    if (response.data && response.data.length > 0) {
                        $.each(response.data, function (i, v) {
                            var rowIdx = ((currentPage - 1) * 10) + (i + 1);
                            var row = createrow(rowIdx, v);
                            $("#dataShow").append(row);
                        });
                    } else {
                        $("#dataShow").html(`
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="fas fa-info-circle fs-4"></i>
                                    <p class="mt-2 mb-0">No users found.</p>
                                </td>
                            </tr>
                        `);
                    }
                } else {
                    $("#dataShow").html(`
                        <tr>
                            <td colspan="6" class="text-center py-4 text-danger">
                                <i class="fas fa-exclamation-triangle fs-4"></i>
                                <p class="mt-2 mb-0">Failed to load data.</p>
                            </td>
                        </tr>
                    `);
                }
            },
            error: function (xhr, textStatus, error) {
                $("#dataShow").html(`
                    <tr>
                        <td colspan="6" class="text-center py-4 text-danger">
                            <i class="fas fa-exclamation-triangle fs-4"></i>
                            <p class="mt-2 mb-0">Failed to load data: ${error || xhr.statusText}</p>
                        </td>
                    </tr>
                `);
            }
        });
    }

    function changePage(direction) {
        var targetPage = currentPage + direction;
        if (targetPage >= 1 && targetPage <= totalPages) {
            loadUsers(targetPage);
        }
    }

    $(document).ready(function () {
        // Disable AJAX caching globally for all GET requests on this page
        $.ajaxSetup({ cache: false });

        // Load users on init
        loadUsers(1);

        // Click handlers for next/previous links
        $('#btnPrevious').on('click', function (e) {
            e.preventDefault();
            changePage(-1);
        });

        $('#btnNext').on('click', function (e) {
            e.preventDefault();
            changePage(1);
        });

        // Search button click handler
        $('#btnSearch').on('click', function () {
            loadUsers(1);
        });

        // Trigger search on Enter keypress inside search box
        $('#searchBox').on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                loadUsers(1);
            }
        });

        // Handle Add User Form Submission via AJAX
        $('#addUserForm').on('submit', function (e) {
            e.preventDefault();
            var form = $(this);
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        showSuccess(response.message);
                        $('#addUserModal').modal('hide');
                        form[0].reset();
                        // Reset Select2 fields inside add modal
                        $('#modalRoleId').val('').trigger('change');
                        $('#modalDepartmentId').val('').trigger('change');
                        $('#modalDoctorId').html('<option value="0">--Select Doctor--</option>').trigger('change');
                        $('#isDoctorCheckbox').prop('checked', false).trigger('change');
                        loadUsers(1);
                    } else {
                        showError(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    showError("An error occurred: " + error);
                }
            });
        });

        // Handle Edit User Form Submission via AJAX
        $('#editUserForm').on('submit', function (e) {
            e.preventDefault();
            var form = $(this);
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        showSuccess(response.message);
                        $('#editUserModal').modal('hide');
                        loadUsers(currentPage);
                    } else {
                        showError(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    showError("An error occurred: " + error);
                }
            });
        });

        // Handle Delete User click via AJAX
        $(document).on('click', '.delete-user-btn', function (e) {
            e.preventDefault();
            var userId = $(this).data('id');

            if (confirm("Are you sure you want to delete this user?")) {
                var clickedBtn = $(this);
                clickedBtn.css('pointer-events', 'none');

                $.ajax({
                    url: '@Url.Action("Delete", "User")',
                    type: 'GET',
                    data: { Id: userId },
                    success: function (response) {
                        if (response.success) {
                            showSuccess(response.message);
                            loadUsers(currentPage);
                        } else {
                            showError(response.message);
                            clickedBtn.css('pointer-events', 'auto');
                        }
                    },
                    error: function (xhr, status, error) {
                        showError("An error occurred: " + error);
                        clickedBtn.css('pointer-events', 'auto');
                    }
                });
            }
        });

        // Handle Status Toggle click via AJAX
        $(document).on('click', '.toggle-status-btn', function (e) {
            e.preventDefault();
            var userId = $(this).data('id');
            var clickedLink = $(this);
            clickedLink.css('pointer-events', 'none');

            $.ajax({
                url: '@Url.Action("GetStatusUpdate", "User")',
                type: 'GET',
                data: { id: userId },
                success: function (response) {
                    if (response.success) {
                        showSuccess(response.message);
                        loadUsers(currentPage);
                    } else {
                        showError(response.message);
                        clickedLink.css('pointer-events', 'auto');
                    }
                },
                error: function (xhr, status, error) {
                    showError("An error occurred: " + error);
                    clickedLink.css('pointer-events', 'auto');
                }
            });
        });

        // Initialize Select2 inside modal when the modal is shown
        $('#addUserModal').on('shown.bs.modal', function () {
            // Reset checkbox and select states
            $('#isDoctorCheckbox').prop('checked', false);
            $('#doctorFieldsRow').hide();
            $('#modalDepartmentId').val('').trigger('change');
            $('#modalDoctorId').html('<option value="0">--Select Doctor--</option>').trigger('change');

            $("#modalRoleId").select2({
                placeholder: "--Select Role--",
                allowClear: true,
                dropdownParent: $('#addUserModal'),
                width: '100%'
            });
        });

        // Toggle Department and Doctor Select containers based on 'Is Doctor?' checkbox
        $('#isDoctorCheckbox').on('change', function () {
            if (this.checked) {
                $('#doctorFieldsRow').show();

                $("#modalDepartmentId").select2({
                    placeholder: "--Select Department--",
                    allowClear: true,
                    dropdownParent: $('#addUserModal'),
                    width: '100%'
                });

                $("#modalDoctorId").select2({
                    placeholder: "--Select Doctor--",
                    allowClear: true,
                    dropdownParent: $('#addUserModal'),
                    width: '100%'
                });
            } else {
                $('#modalDepartmentId').val('').trigger('change');
                $('#modalDoctorId').html('<option value="0">--Select Doctor--</option>').trigger('change');
                $('#doctorFieldsRow').hide();
            }
        });

        // Cascading Dropdown: Load Doctors when Department changes
        $(document).on('change', '#modalDepartmentId', function () {
            var deptId = $(this).val();
            if (deptId) {
                $.getJSON('@Url.Action("GetDoctorsByDepartment", "User")', { departmentId: deptId }, function (data) {
                    var items = '<option value="0">--Select Doctor--</option>';
                    $.each(data, function (i, doc) {
                        items += '<option value="' + doc.id + '">' + doc.name + '</option>';
                    });
                    $('#modalDoctorId').html(items).trigger('change');
                });
            } else {
                $('#modalDoctorId').html('<option value="0">--Select Doctor--</option>').trigger('change');
            }
        });

        // Edit User button click handler
        $(document).on('click', '.edit-user-btn', function () {
            var userId = $(this).data('id');
            
            // Fetch user details via AJAX
            $.getJSON('@Url.Action("GetUserById", "User")', { id: userId }, function (data) {
                // Populate modal fields
                $('#editUserId').val(data.id);
                $('#editName').val(data.name);
                $('#editMobileNo').val(data.mobileNo);
                $('#editUserName').val(data.userName);
                
                // Initialize/Reset Select2 for Role
                $("#editRoleId").select2({
                    placeholder: "--Select Role--",
                    allowClear: true,
                    dropdownParent: $('#editUserModal'),
                    width: '100%'
                });
                $('#editRoleId').val(data.roleId).trigger('change');
                
                // Check if user is associated with a doctor
                if (data.doctorId > 0) {
                    $('#editIsDoctorCheckbox').prop('checked', true);
                    $('#editDoctorFieldsRow').show();
                    
                    // Initialize Select2 for Department and Doctor
                    $("#editDepartmentId").select2({
                        placeholder: "--Select Department--",
                        allowClear: true,
                        dropdownParent: $('#editUserModal'),
                        width: '100%'
                    });
                    $('#editDepartmentId').val(data.departmentId).trigger('change');
                    
                    // Load doctors cascade for selected department and pre-set doctor
                    $.getJSON('@Url.Action("GetDoctorsByDepartment", "User")', { departmentId: data.departmentId }, function (doctors) {
                        var items = '<option value="0">--Select Doctor--</option>';
                        $.each(doctors, function (i, doc) {
                            items += '<option value="' + doc.id + '">' + doc.name + '</option>';
                        });
                        $('#editDoctorId').html(items);
                        
                        $("#editDoctorId").select2({
                            placeholder: "--Select Doctor--",
                            allowClear: true,
                            dropdownParent: $('#editUserModal'),
                            width: '100%'
                        });
                        $('#editDoctorId').val(data.doctorId).trigger('change');
                    });
                } else {
                    $('#editIsDoctorCheckbox').prop('checked', false);
                    $('#editDoctorFieldsRow').hide();
                    $('#editDepartmentId').val('').trigger('change');
                    $('#editDoctorId').html('<option value="0">--Select Doctor--</option>').trigger('change');
                }
                
                // Show Edit Modal
                $('#editUserModal').modal('show');
            }).fail(function() {
                showError("Error loading user data.");
            });
        });

        // Initialize Select2 inside edit modal when the modal is shown
        $('#editUserModal').on('shown.bs.modal', function () {
            $("#editRoleId").select2({
                placeholder: "--Select Role--",
                allowClear: true,
                dropdownParent: $('#editUserModal'),
                width: '100%'
            });
        });

        // Toggle Department and Doctor Select containers based on 'Is Doctor?' checkbox in Edit Modal
        $('#editIsDoctorCheckbox').on('change', function () {
            if (this.checked) {
                $('#editDoctorFieldsRow').show();

                $("#editDepartmentId").select2({
                    placeholder: "--Select Department--",
                    allowClear: true,
                    dropdownParent: $('#editUserModal'),
                    width: '100%'
                });

                $("#editDoctorId").select2({
                    placeholder: "--Select Doctor--",
                    allowClear: true,
                    dropdownParent: $('#editUserModal'),
                    width: '100%'
                });
            } else {
                $('#editDepartmentId').val('').trigger('change');
                $('#editDoctorId').html('<option value="0">--Select Doctor--</option>').trigger('change');
                $('#editDoctorFieldsRow').hide();
            }
        });

        // Cascading Dropdown: Load Doctors when Department changes in Edit Modal
        $(document).on('change', '#editDepartmentId', function () {
            var deptId = $(this).val();
            if (deptId) {
                $.getJSON('@Url.Action("GetDoctorsByDepartment", "User")', { departmentId: deptId }, function (data) {
                    var items = '<option value="0">--Select Doctor--</option>';
                    $.each(data, function (i, doc) {
                        items += '<option value="' + doc.id + '">' + doc.name + '</option>';
                    });
                    $('#editDoctorId').html(items).trigger('change');
                });
            } else {
                $('#editDoctorId').html('<option value="0">--Select Doctor--</option>').trigger('change');
            }
        });

        // Check for editId URL query parameter and trigger edit if present
        const urlParams = new URLSearchParams(window.location.search);
        const editId = urlParams.get('editId');
        if (editId) {
            const editBtn = $(`.edit-user-btn[data-id="${editId}"]`);
            if (editBtn.length) {
                editBtn.click();
            } else {
                $.getJSON('@Url.Action("GetUserById", "User")', { id: editId }, function (data) {
                    $('#editUserId').val(data.id);
                    $('#editName').val(data.name);
                    $('#editMobileNo').val(data.mobileNo);
                    $('#editUserName').val(data.userName);
                    
                    $("#editRoleId").select2({
                        placeholder: "--Select Role--",
                        allowClear: true,
                        dropdownParent: $('#editUserModal'),
                        width: '100%'
                    });
                    $('#editRoleId').val(data.roleId).trigger('change');
                    
                    if (data.doctorId > 0) {
                        $('#editIsDoctorCheckbox').prop('checked', true);
                        $('#editDoctorFieldsRow').show();
                        
                        $("#editDepartmentId").select2({
                            placeholder: "--Select Department--",
                            allowClear: true,
                            dropdownParent: $('#editUserModal'),
                            width: '100%'
                        });
                        $('#editDepartmentId').val(data.departmentId).trigger('change');
                        
                        $.getJSON('@Url.Action("GetDoctorsByDepartment", "User")', { departmentId: data.departmentId }, function (doctors) {
                            var items = '<option value="0">--Select Doctor--</option>';
                            $.each(doctors, function (i, doc) {
                                items += '<option value="' + doc.id + '">' + doc.name + '</option>';
                            });
                            $('#editDoctorId').html(items);
                            
                            $("#editDoctorId").select2({
                                placeholder: "--Select Doctor--",
                                allowClear: true,
                                dropdownParent: $('#editUserModal'),
                                width: '100%'
                            });
                            $('#editDoctorId').val(data.doctorId).trigger('change');
                        });
                    } else {
                        $('#editIsDoctorCheckbox').prop('checked', false);
                        $('#editDoctorFieldsRow').hide();
                        $('#editDepartmentId').val('').trigger('change');
                        $('#editDoctorId').html('<option value="0">--Select Doctor--</option>').trigger('change');
                    }
                    
                    $('#editUserModal').modal('show');
                });
            }
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    });
</script>