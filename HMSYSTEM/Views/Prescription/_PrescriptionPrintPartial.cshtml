@model HMSYSTEM.ViewModels.PrescriptionViewModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Prescription - @Model.PatientName</title>
    <style type="text/css">
        @@media print {
            @@page {
                size: A4 portrait;
                margin: 5mm;
            }
            body {
                margin: 0;
                padding: 0;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                font-family: 'Segoe UI', Arial, sans-serif;
                background: #ffffff;
                color: #000000;
            }
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #1a202c;
            background: #ffffff;
            margin: 0;
            padding: 5px;
        }

        .print-pad {
            border: 1.5px solid #2b6cb0;
            padding: 15px 20px;
            box-sizing: border-box;
            width: 100%;
            background: #ffffff;
        }

        .header-section {
            border-bottom: 2px solid #2b6cb0;
            padding-bottom: 8px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .doc-info {
            width: 50%;
        }

        .doc-name {
            font-size: 14pt;
            font-weight: bold;
            color: #2b6cb0;
            margin: 0 0 2px 0;
        }

        .doc-deg {
            font-size: 9pt;
            color: #4a5568;
            margin: 0 0 2px 0;
        }

        .hosp-info {
            width: 48%;
            text-align: right;
        }

        .hosp-name {
            font-size: 13pt;
            font-weight: bold;
            color: #2d3748;
            margin: 0 0 2px 0;
        }

        .hosp-sub {
            font-size: 8.5pt;
            color: #718096;
            margin: 0 0 1px 0;
        }

        .patient-box {
            border: 1px solid #cbd5e0;
            background-color: #f7fafc;
            padding: 6px 12px;
            border-radius: 4px;
            margin-bottom: 12px;
            font-size: 9pt;
            display: flex;
            justify-content: space-between;
        }

        .patient-box-col {
            width: 48%;
        }

        .patient-box-col div {
            margin-bottom: 2px;
        }

        .rx-title {
            font-size: 18pt;
            font-weight: bold;
            font-family: Georgia, serif;
            color: #2b6cb0;
            margin-bottom: 6px;
            margin-top: 4px;
        }

        .rx-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 12px;
        }

        .rx-table th {
            background-color: #ebf8ff !important;
            color: #2b6cb0 !important;
            font-size: 8.5pt;
            font-weight: bold;
            text-transform: uppercase;
            border: 1px solid #bee3f8;
            padding: 6px 8px;
            text-align: left;
        }

        .rx-table td {
            border: 1px solid #e2e8f0;
            padding: 6px 8px;
            font-size: 9pt;
            vertical-align: middle;
        }

        .advice-box {
            border: 1px solid #feebc8;
            background-color: #fffaf0 !important;
            padding: 8px 12px;
            border-radius: 4px;
            margin-top: 10px;
            font-size: 9pt;
        }

        .advice-header {
            font-weight: bold;
            color: #c05621;
            margin-bottom: 4px;
        }

        .footer-sig {
            margin-top: 35px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .sig-box {
            border-top: 1px dashed #718096;
            width: 160px;
            text-align: center;
            padding-top: 4px;
            font-size: 8.5pt;
            font-weight: bold;
            color: #4a5568;
        }
    </style>
</head>
<body>

    <div class="print-pad">

        <!-- Header -->
        <div class="header-section">
            <div class="doc-info">
                <div class="doc-name">Dr. @Model.DoctorName</div>
                <div class="doc-deg">@Model.DesignationName</div>
                <div class="doc-deg">Contact: @Model.DoctorMobile</div>
            </div>
            <div class="hosp-info">
                <div class="hosp-name">Hospital Management</div>
                <div class="hosp-sub">Charghat, Rajshahi</div>
                <div class="hosp-sub">Helpline: 01791177192</div>
            </div>
        </div>

        <!-- Patient Info -->
        <div class="patient-box">
            <div class="patient-box-col">
                <div><strong>Patient Name:</strong> @Model.PatientName</div>
                <div><strong>Phone:</strong> @Model.PatientMobileNo</div>
                <div><strong>Address:</strong> @Model.PatientAddress</div>
            </div>
            <div class="patient-box-col" style="text-align: right;">
                <div><strong>Date:</strong> @(Model.Date?.ToString("dd MMM yyyy") ?? "N/A")</div>
                <div><strong>Department:</strong> @Model.DepartmentName</div>
                <div><strong>Next Follow Up:</strong> @(Model.NextFlowUp?.ToString("dd MMM yyyy") ?? "As Needed")</div>
            </div>
        </div>

        <!-- Rx Symbol -->
        <div class="rx-title">R<sub>x</sub></div>

        <!-- Medicine Table -->
        <table class="rx-table">
            <thead>
                <tr>
                    <th style="width: 5%">#</th>
                    <th style="width: 40%">Medicine</th>
                    <th style="width: 20%">Dose</th>
                    <th style="width: 15%">Duration</th>
                    <th style="width: 20%">Instructions</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 1; }
                @foreach (var detail in Model.PrescriptionDetails)
                {
                    <tr>
                        <td>@(idx++)</td>
                        <td>
                            <strong>@detail.MedicineName</strong>
                            <span style="font-size: 8pt; color: #718096;">(@detail.Strength, @detail.Form)</span>
                        </td>
                        <td>@detail.Dose</td>
                        <td>@detail.Duration</td>
                        <td>@(detail.Instructions == true ? "After Meal" : "Before Meal")</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Doctor Advice -->
        @if (!string.IsNullOrWhiteSpace(Model.Note))
        {
            var noteLines = Model.Note.Split(new[] { '.', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            int advIdx = 1;
            <div class="advice-box">
                <div class="advice-header">Doctor's Advice:</div>
                @foreach (var line in noteLines)
                {
                    if (!string.IsNullOrWhiteSpace(line.Trim()))
                    {
                        <div><strong>@(advIdx++).</strong> @line.Trim()</div>
                    }
                }
            </div>
        }

        <!-- Footer / Signature -->
        <div class="footer-sig">
            <div style="font-size: 8pt; color: #718096;">
                Generated by HMS | Wish you a healthy life!
            </div>
            <div class="sig-box">
                Doctor's Signature
            </div>
        </div>

    </div>

</body>
</html>
