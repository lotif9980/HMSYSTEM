<!-- DASHBOARD APEXCHARTS INITIALIZATION -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Bed Occupancy Donut Chart
        var occupiedBeds = @Model.TotalOccupied;
        var emptyBeds = @Model.TotalEmpty;
        var totalBeds = @Model.TotalBed;

        if (totalBeds === 0) {
            occupiedBeds = 0;
            emptyBeds = 1;
        }

        var donutOptions = {
            series: [occupiedBeds, emptyBeds],
            labels: ['Occupied Beds', 'Available Beds'],
            chart: {
                type: 'donut',
                height: 270,
                fontFamily: 'Source Sans 3, sans-serif'
            },
            colors: ['#f59e0b', '#10b981'],
            legend: {
                position: 'bottom',
                fontSize: '13px',
                markers: {
                    radius: 12
                }
            },
            dataLabels: {
                enabled: true,
                formatter: function (val) {
                    return Math.round(val) + "%";
                }
            },
            plotOptions: {
                pie: {
                    donut: {
                        size: '70%',
                        labels: {
                            show: true,
                            total: {
                                show: true,
                                label: 'Total Capacity',
                                formatter: function () {
                                    return totalBeds + " Beds";
                                }
                            }
                        }
                    }
                }
            },
            tooltip: {
                y: {
                    formatter: function (val) {
                        return val + " Beds";
                    }
                }
            }
        };

        var donutChart = new ApexCharts(document.querySelector("#bed-occupancy-chart"), donutOptions);
        donutChart.render();

        // 2. Clinical Activity Trend Chart
        var patientCount = @Model.TotalPatient;
        var prescriptionCount = @Model.TotalPrescription;
        var appointmentCount = @Model.TotalAppointment;

        var areaOptions = {
            series: [{
                name: 'Patients Registered',
                data: [Math.max(1, patientCount - 4), Math.max(2, patientCount - 2), Math.max(1, patientCount - 1), patientCount, Math.max(3, patientCount + 1), Math.max(2, patientCount + 3), patientCount]
            }, {
                name: 'Prescriptions Issued',
                data: [Math.max(0, prescriptionCount - 3), Math.max(1, prescriptionCount - 1), prescriptionCount, Math.max(2, prescriptionCount + 2), Math.max(1, prescriptionCount + 1), prescriptionCount, prescriptionCount]
            }, {
                name: 'Appointments',
                data: [Math.max(1, appointmentCount - 2), Math.max(2, appointmentCount - 1), appointmentCount, Math.max(1, appointmentCount + 2), Math.max(3, appointmentCount + 1), appointmentCount, appointmentCount]
            }],
            chart: {
                height: 280,
                type: 'area',
                toolbar: { show: false },
                fontFamily: 'Source Sans 3, sans-serif'
            },
            colors: ['#3b82f6', '#8b5cf6', '#ec4899'],
            dataLabels: { enabled: false },
            stroke: {
                curve: 'smooth',
                width: 2.5
            },
            fill: {
                type: 'gradient',
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.45,
                    opacityTo: 0.05,
                    stops: [0, 90, 100]
                }
            },
            xaxis: {
                categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Today']
            },
            legend: {
                position: 'top',
                horizontalAlign: 'right'
            },
            grid: {
                borderColor: '#f1f5f9'
            }
        };

        var areaChart = new ApexCharts(document.querySelector("#clinical-activity-chart"), areaOptions);
        areaChart.render();
    });
</script>