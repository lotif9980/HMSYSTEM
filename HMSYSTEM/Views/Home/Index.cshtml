@model HMSYSTEM.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Dashboard - HMS Control Center";
    double occupancyRate = Model.TotalBed > 0 ? Math.Round((double)Model.TotalOccupied / Model.TotalBed * 100, 1) : 0;
    double emptyRate = Model.TotalBed > 0 ? Math.Round((double)Model.TotalEmpty / Model.TotalBed * 100, 1) : 0;
}

<style>
    /* Premium Dashboard Styles */
    :root {
        --hms-primary: #3b82f6;
        --hms-secondary: #64748b;
        --hms-success: #10b981;
        --hms-warning: #f59e0b;
        --hms-danger: #ef4444;
        --hms-info: #06b6d4;
        --hms-purple: #8b5cf6;
        --hms-rose: #f43f5e;
        --hms-card-bg: #ffffff;
        --hms-card-border: #e2e8f0;
    }

    .dashboard-wrapper {
        padding: 1.5rem 0.5rem;
        background-color: #f8fafc;
        min-height: calc(100vh - 100px);
    }

    /* Welcome Hero Banner */
    .hero-banner {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #334155 100%);
        border-radius: 1.25rem;
        padding: 2rem 2.25rem;
        color: #ffffff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.25);
        margin-bottom: 2rem;
    }

    .hero-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.18) 0%, rgba(255, 255, 255, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .hero-banner::after {
        content: '';
        position: absolute;
        bottom: -40%;
        left: 20%;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .hero-badge {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #38bdf8;
        font-size: 0.825rem;
        font-weight: 600;
        padding: 0.35rem 0.85rem;
        border-radius: 2rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .hero-title {
        font-size: 1.85rem;
        font-weight: 700;
        margin-top: 0.75rem;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
    }

    .hero-subtitle {
        color: #94a3b8;
        font-size: 0.975rem;
        max-width: 600px;
        margin-bottom: 1.5rem;
    }

    .hero-btn {
        padding: 0.65rem 1.25rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

    .hero-btn-primary {
        background: #3b82f6;
        color: #ffffff;
        border: none;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
    }

    .hero-btn-primary:hover {
        background: #2563eb;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(59, 130, 246, 0.5);
    }

    .hero-btn-glass {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .hero-btn-glass:hover {
        background: rgba(255, 255, 255, 0.2);
        color: #ffffff;
        transform: translateY(-2px);
    }

    /* KPI Stat Cards */
    .kpi-card {
        background: var(--hms-card-bg);
        border: 1px solid var(--hms-card-border);
        border-radius: 1.15rem;
        padding: 1.35rem 1.25rem;
        position: relative;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .kpi-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        border-color: #cbd5e1;
    }

    .kpi-icon-box {
        width: 50px;
        height: 50px;
        border-radius: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        color: #ffffff;
        box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.15);
        transition: transform 0.3s ease;
    }

    .kpi-card:hover .kpi-icon-box {
        transform: scale(1.08) rotate(3deg);
    }

    .kpi-value {
        font-size: 1.85rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.2;
        margin-top: 0.75rem;
        margin-bottom: 0.2rem;
        letter-spacing: -0.02em;
    }

    .kpi-label {
        color: #64748b;
        font-size: 0.875rem;
        font-weight: 600;
        margin: 0;
    }

    .kpi-footer-link {
        margin-top: 1rem;
        padding-top: 0.75rem;
        border-top: 1px border-top: 1px dashed #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.825rem;
        font-weight: 600;
        color: #3b82f6;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .kpi-footer-link:hover {
        color: #1d4ed8;
    }

    /* KPI Specific Color Variants */
    .icon-ward { background: linear-gradient(135deg, #06b6d4, #0891b2); }
    .icon-bed { background: linear-gradient(135deg, #6366f1, #4f46e5); }
    .icon-occupied { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .icon-empty { background: linear-gradient(135deg, #10b981, #059669); }
    .icon-patient { background: linear-gradient(135deg, #3b82f6, #2563eb); }
    .icon-prescription { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
    .icon-appointment { background: linear-gradient(135deg, #ec4899, #db2777); }
    .icon-doctor { background: linear-gradient(135deg, #14b8a6, #0d9488); }

    /* Dashboard Widgets Section */
    .widget-card {
        background: var(--hms-card-bg);
        border: 1px solid var(--hms-card-border);
        border-radius: 1.15rem;
        padding: 1.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03);
        margin-bottom: 1.5rem;
        height: 100%;
    }

    .widget-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .widget-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin: 0;
    }

    .widget-title-icon {
        width: 32px;
        height: 32px;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    /* Quick Action Pill Buttons */
    .quick-action-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
        color: #1e293b;
        transition: all 0.25s ease;
    }

    .quick-action-card:hover {
        border-color: #3b82f6;
        background: #f0f7ff;
        transform: translateY(-3px);
        box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.1);
        color: #1d4ed8;
    }

    .quick-action-icon {
        width: 44px;
        height: 44px;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    /* Custom Badges */
    .badge-soft-success {
        background-color: #d1fae5;
        color: #065f46;
        font-weight: 600;
        padding: 0.35rem 0.65rem;
        border-radius: 0.5rem;
    }

    .badge-soft-warning {
        background-color: #fef3c7;
        color: #92400e;
        font-weight: 600;
        padding: 0.35rem 0.65rem;
        border-radius: 0.5rem;
    }

    .badge-soft-primary {
        background-color: #dbeafe;
        color: #1e40af;
        font-weight: 600;
        padding: 0.35rem 0.65rem;
        border-radius: 0.5rem;
    }

    /* Progress bar custom styling */
    .custom-progress {
        height: 10px;
        border-radius: 10px;
        background-color: #e2e8f0;
        overflow: hidden;
    }

    .progress-bar-occupied {
        background: linear-gradient(90deg, #f59e0b, #ef4444);
    }

    .progress-bar-empty {
        background: linear-gradient(90deg, #10b981, #059669);
    }
</style>

<div class="dashboard-wrapper">
    <div class="container-fluid px-3">

        <!-- HERO WELCOME BANNER -->
        <div class="hero-banner">
            <div class="row align-items-center">
                <div class="col-lg-7 col-md-7">
                    <div class="hero-badge">
                        <i class="bi bi-shield-check"></i> CarePulse HMS &bull; Real-time Control Center
                    </div>
                    <h1 class="hero-title">Hospital Operations Console</h1>
                    <p class="hero-subtitle">
                        Monitor inpatient beds, daily clinic appointments, doctor rosters, and patient admissions live.
                    </p>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <a asp-controller="Patient" asp-action="Index" class="hero-btn hero-btn-primary">
                            <i class="bi bi-person-plus-fill"></i> Register Patient
                        </a>
                        <a asp-controller="Appointment" asp-action="Index" class="hero-btn hero-btn-glass">
                            <i class="bi bi-calendar2-check"></i> Appointments
                        </a>
                        <a asp-controller="Prescription" asp-action="Index" class="hero-btn hero-btn-glass">
                            <i class="bi bi-journal-plus"></i> Prescriptions
                        </a>
                        <a asp-controller="Admission" asp-action="Index" class="hero-btn hero-btn-glass">
                            <i class="bi bi-door-open"></i> Admission
                        </a>
                    </div>
                </div>

                <div class="col-lg-5 col-md-5 d-none d-md-block">
                    <div class="p-3.5 rounded-4" style="background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.15); backdrop-filter: blur(14px);">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-white-50 small font-weight-bold">Beds Capacity Status</span>
                            <span class="badge @(occupancyRate > 80 ? "bg-danger" : occupancyRate > 50 ? "bg-warning text-dark" : "bg-success")">
                                @occupancyRate% Occupied
                            </span>
                        </div>
                        <div class="custom-progress mb-3">
                            <div class="progress-bar progress-bar-occupied" role="progressbar" style="width: @occupancyRate%" aria-valuenow="@occupancyRate" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="row text-center text-white g-2">
                            <div class="col-6 border-end border-secondary">
                                <small class="text-white-50 d-block">Occupied Beds</small>
                                <strong class="fs-4 text-warning">@Model.TotalOccupied</strong>
                            </div>
                            <div class="col-6">
                                <small class="text-white-50 d-block">Available Vacancies</small>
                                <strong class="fs-4 text-success">@Model.TotalEmpty</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- EMERGENCY HOTLINE & SYSTEM ANNOUNCEMENT STRIP -->
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="p-3 bg-white rounded-4 border d-flex flex-wrap align-items-center justify-content-between gap-3 shadow-sm">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2.5 rounded-3 text-danger" style="background: #fef2f2; font-size: 1.35rem;">
                            <i class="bi bi-telephone-outbound-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-bold uppercase d-block">Hospital Emergency Hotline</span>
                            <strong class="text-dark fs-6">ICU Ext: 104 &bull; Ambulance: 01791177192 &bull; Emergency Desk: Ext 101</strong>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge badge-soft-warning"><i class="bi bi-bell-fill me-1"></i> Duty Doctors On Shift: <strong>@Model.TotalDoctor Doctors</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 8 KPI STAT CARDS GRID -->
        <div class="row g-3 mb-4">
            <!-- 1. Total Ward -->
            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                <div class="kpi-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="kpi-label">Active Wards</p>
                            <h2 class="kpi-value">@Model.TotalWard</h2>
                            <span class="badge badge-soft-primary fs-8">Operational</span>
                        </div>
                        <div class="kpi-icon-box icon-ward">
                            <i class="bi bi-hospital"></i>
                        </div>
                    </div>
                    <a asp-controller="Ward" asp-action="Index" class="kpi-footer-link">
                        <span>Manage Wards</span>
                        <i class="bi bi-arrow-right-short fs-5"></i>
                    </a>
                </div>
            </div>

            <!-- 2. Total Bed -->
            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                <div class="kpi-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="kpi-label">Total Beds Capacity</p>
                            <h2 class="kpi-value">@Model.TotalBed</h2>
                            <span class="badge badge-soft-primary fs-8">IPD Capacity</span>
                        </div>
                        <div class="kpi-icon-box icon-bed">
                            <i class="bi bi-badge-ad"></i>
                        </div>
                    </div>
                    <a asp-controller="Bed" asp-action="Index" class="kpi-footer-link">
                        <span>View Bed Roster</span>
                        <i class="bi bi-arrow-right-short fs-5"></i>
                    </a>
                </div>
            </div>

            <!-- 3. Occupied Beds -->
            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                <div class="kpi-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="kpi-label">Occupied Beds</p>
                            <h2 class="kpi-value text-warning">@Model.TotalOccupied</h2>
                            <span class="badge badge-soft-warning fs-8">@occupancyRate% Occupied</span>
                        </div>
                        <div class="kpi-icon-box icon-occupied">
                            <i class="bi bi-person-workspace"></i>
                        </div>
                    </div>
                    <a asp-controller="Admission" asp-action="Index" class="kpi-footer-link">
                        <span>Admitted Patients</span>
                        <i class="bi bi-arrow-right-short fs-5"></i>
                    </a>
                </div>
            </div>

            <!-- 4. Available Beds -->
            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                <div class="kpi-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="kpi-label">Available Empty Beds</p>
                            <h2 class="kpi-value text-success">@Model.TotalEmpty</h2>
                            <span class="badge badge-soft-success fs-8">@emptyRate% Vacant</span>
                        </div>
                        <div class="kpi-icon-box icon-empty">
                            <i class="bi bi-check-circle"></i>
                        </div>
                    </div>
                    <a asp-controller="Bed" asp-action="Index" class="kpi-footer-link">
                        <span>Check Vacancy</span>
                        <i class="bi bi-arrow-right-short fs-5"></i>
                    </a>
                </div>
            </div>

            <!-- 5. Total Patients Today -->
            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                <div class="kpi-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="kpi-label">Today Total Patients</p>
                            <h2 class="kpi-value">@Model.TotalPatient</h2>
                        </div>
                        <div class="kpi-icon-box icon-patient">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                    <a asp-controller="Patient" asp-action="Index" class="kpi-footer-link">
                        <span>Patient Records</span>
                        <i class="bi bi-arrow-right-short fs-5"></i>
                    </a>
                </div>
            </div>

            <!-- 6. Total Prescriptions Today -->
            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                <div class="kpi-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="kpi-label">Today Prescriptions</p>
                            <h2 class="kpi-value">@Model.TotalPrescription</h2>
                        </div>
                        <div class="kpi-icon-box icon-prescription">
                            <i class="bi bi-file-earmark-medical"></i>
                        </div>
                    </div>
                    <a asp-controller="Prescription" asp-action="Index" class="kpi-footer-link">
                        <span>View Prescriptions</span>
                        <i class="bi bi-arrow-right-short fs-5"></i>
                    </a>
                </div>
            </div>

            <!-- 7. Total Appointments Today -->
            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                <div class="kpi-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="kpi-label">Today Appointments</p>
                            <h2 class="kpi-value">@Model.TotalAppointment</h2>
                        </div>
                        <div class="kpi-icon-box icon-appointment">
                            <i class="bi bi-calendar-event"></i>
                        </div>
                    </div>
                    <a asp-controller="Appointment" asp-action="Index" class="kpi-footer-link">
                        <span>View Schedules</span>
                        <i class="bi bi-arrow-right-short fs-5"></i>
                    </a>
                </div>
            </div>

            <!-- 8. Total Active Doctors -->
            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                <div class="kpi-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="kpi-label">Active Doctors</p>
                            <h2 class="kpi-value">@Model.TotalDoctor</h2>
                        </div>
                        <div class="kpi-icon-box icon-doctor">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                    </div>
                    <a asp-controller="Doctor" asp-action="Index" class="kpi-footer-link">
                        <span>Doctor Directory</span>
                        <i class="bi bi-arrow-right-short fs-5"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- CHARTS & VISUAL ANALYTICS SECTION -->
        <div class="row g-3 mb-4">
            <!-- Bed Capacity Radial/Donut Chart -->
            <div class="col-lg-5 col-12">
                <div class="widget-card">
                    <div class="widget-header">
                        <h3 class="widget-title">
                            <span class="widget-title-icon bg-primary text-white">
                                <i class="bi bi-pie-chart-fill"></i>
                            </span>
                            Bed Occupancy Analytics
                        </h3>
                        <span class="badge badge-soft-primary">Live Status</span>
                    </div>
                    <div id="bed-occupancy-chart" style="min-height: 280px;"></div>
                    <div class="row text-center mt-3 pt-3 border-top">
                        <div class="col-6">
                            <div class="p-2 rounded bg-light">
                                <small class="text-muted d-block">Occupied Ratio</small>
                                <strong class="text-warning fs-5">@occupancyRate%</strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 rounded bg-light">
                                <small class="text-muted d-block">Available Vacancy</small>
                                <strong class="text-success fs-5">@emptyRate%</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Weekly Operational Activity Trend -->
            <div class="col-lg-7 col-12">
                <div class="widget-card">
                    <div class="widget-header">
                        <h3 class="widget-title">
                            <span class="widget-title-icon bg-info text-white">
                                <i class="bi bi-graph-up-arrow"></i>
                            </span>
                            Clinical Activity Overview
                        </h3>
                        <span class="badge badge-soft-success">Weekly Summary</span>
                    </div>
                    <div id="clinical-activity-chart" style="min-height: 280px;"></div>
                </div>
            </div>
        </div>

        <!-- QUICK ACCESS HUB MODULES -->
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="widget-card">
                    <div class="widget-header">
                        <h3 class="widget-title">
                            <span class="widget-title-icon bg-dark text-white">
                                <i class="bi bi-grid-3x3-gap-fill"></i>
                            </span>
                            Hospital Operations Hub
                        </h3>
                        <span class="text-muted small">Direct Access Shortcuts</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                            <a asp-controller="Patient" asp-action="Index" class="quick-action-card">
                                <div class="quick-action-icon bg-primary text-white">
                                    <i class="bi bi-person-lines-fill"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1 font-weight-bold">Patients</h6>
                                    <small class="text-muted">Register & manage patients</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                            <a asp-controller="Appointment" asp-action="Index" class="quick-action-card">
                                <div class="quick-action-icon bg-success text-white">
                                    <i class="bi bi-calendar-check"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1 font-weight-bold">Appointments</h6>
                                    <small class="text-muted">Book & review schedules</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                            <a asp-controller="Prescription" asp-action="Index" class="quick-action-card">
                                <div class="quick-action-icon bg-purple text-white" style="background: #8b5cf6;">
                                    <i class="bi bi-file-earmark-medical"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1 font-weight-bold">Prescriptions</h6>
                                    <small class="text-muted">Generate & print RX</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                            <a asp-controller="Admission" asp-action="Index" class="quick-action-card">
