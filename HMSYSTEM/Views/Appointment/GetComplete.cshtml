@{
    ViewData["Title"] = "Appointment - Completed";
}

<style>
    .appt-card { border:none !important; border-radius:16px !important; box-shadow:0 10px 30px rgba(0,0,0,0.04) !important; background:#ffffff; overflow:hidden; }
    .appt-card-header { background:#ffffff !important; border-bottom:1px solid #f1f2f6 !important; padding:1.25rem 2rem !important; }
    .header-icon { width:44px; height:44px; background:rgba(49,130,206,0.1); color:#3182ce; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.25rem; }
    .appt-card-title { font-size:1.3rem; font-weight:800; color:#2d3748; margin:0; }
    .appt-card-subtitle { font-size:0.82rem; color:#718096; margin:2px 0 0 0; }

    .tab-nav-pills .tab-btn { background:#f7fafc; border:1.5px solid #e2e8f0; color:#4a5568; border-radius:30px !important; padding:6px 18px; font-size:0.85rem; font-weight:700; text-decoration:none !important; transition:all 0.2s ease; display:inline-flex; align-items:center; gap:6px; }
    .tab-nav-pills .tab-btn:hover,.tab-nav-pills .tab-btn.active { background:linear-gradient(135deg,#3182ce 0%,#2b6cb0 100%) !important; color:#ffffff !important; border-color:#3182ce !important; box-shadow:0 4px 12px rgba(49,130,206,0.25); }

    .search-wrapper { position:relative; min-width:240px; }
    .search-wrapper .search-icon { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#a0aec0; font-size:0.9rem; pointer-events:none; }
    .search-wrapper input.search-control { padding-left:40px !important; border-radius:30px !important; border:1.5px solid #e2e8f0 !important; font-size:0.9rem !important; height:38px !important; box-shadow:none !important; background-color:#f7fafc !important; }
    .search-wrapper input.search-control:focus { border-color:#3182ce !important; background-color:#ffffff !important; box-shadow:0 0 0 3px rgba(66,153,225,0.15) !important; }

    .table-container { padding:1rem 1.5rem !important; }
    #completeTable { border-collapse:separate !important; border-spacing:0 !important; width:100% !important; border:none !important; }
    #completeTable th { background-color:#f7fafc !important; color:#4a5568 !important; font-weight:700 !important; text-transform:uppercase !important; font-size:0.75rem !important; letter-spacing:0.8px !important; padding:14px 16px !important; border-bottom:2px solid #edf2f7 !important; border-top:none !important; }
    #completeTable td { padding:13px 16px !important; vertical-align:middle !important; border-bottom:1px solid #edf2f7 !important; color:#2d3748 !important; font-size:0.88rem !important; }
    #completeTable tbody tr:hover { background-color:#f7fafc !important; }

    .pagination .page-link { box-shadow:none !important; }
    .pagination .page-item:not(.disabled) .page-link:hover { background-color:#3182ce !important; color:#ffffff !important; border-color:#3182ce !important; }
    .pagination .page-item.disabled .page-link { color:#a0aec0 !important; background-color:#f7fafc !important; border-color:#edf2f7 !important; pointer-events:none; }
</style>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card appt-card mb-4">

                <div class="card-header appt-card-header">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="header-icon"><i class="fas fa-check-double"></i></div>
                            <div>
                                <h3 class="appt-card-title">Appointment — Completed</h3>
                                <p class="appt-card-subtitle">Successfully completed appointments and their records.</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <div class="search-wrapper">
                                <i class="fas fa-search search-icon"></i>
                                <input type="text" class="form-control search-control" placeholder="Search..." id="completeSearchBox" />
                            </div>
                            <button type="button" id="btnCompleteSearch" class="btn btn-primary"
                                style="border-radius:30px; height:38px; padding:0 1.2rem; font-weight:700; background-color:#3182ce; border-color:#3182ce; display:inline-flex; align-items:center; gap:6px;">
                                <i class="fas fa-search"></i> Search
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Tab Navigation -->
                <div style="background:#f7fafc; border-bottom:1px solid #edf2f7; padding:0.8rem 2rem; display:flex; gap:10px; flex-wrap:wrap;">
                    <div class="tab-nav-pills d-flex gap-2 flex-wrap">
                        <a href="@Url.Action("Index","Appointment")" class="tab-btn"><i class="fas fa-list"></i> Open</a>
                        <a href="@Url.Action("GetProgress","Appointment")" class="tab-btn"><i class="fas fa-spinner"></i> Progress</a>
                        <a href="@Url.Action("GetComplete","Appointment")" class="tab-btn active"><i class="fas fa-check-double"></i> Complete</a>
                        <a href="@Url.Action("GetDeleteList","Appointment")" class="tab-btn"><i class="fas fa-trash-alt"></i> Deleted</a>
                    </div>
                </div>

                <div class="card-body table-container">
                    <table id="completeTable" class="table table-hover">
                        <thead>
                            <tr>
                                <th style="width:55px">Sl No</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Serial</th>
                                <th>Patient Name</th>
                                <th>Phone</th>
                                <th>Department</th>
                                <th>Doctor</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="completeTableBody"></tbody>
                    </table>
                </div>

                <div class="card-footer" style="background-color:#ffffff; border-top:1px solid #f1f2f6; padding:1.25rem 2rem;">
                    <div class="row align-items-center">
                        <div class="col-sm-6 text-center text-sm-start mb-3 mb-sm-0">
                            <div class="text-muted" style="font-size:0.85rem;">
                                Showing page <span id="cpCPage" class="fw-bold text-dark">0</span> of
                                <span id="cpTPage" class="fw-bold text-dark">0</span>
                                (<span id="cpTEntries" class="fw-bold text-dark">0</span> total entries)
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <nav class="d-flex justify-content-center justify-content-sm-end">
                                <ul class="pagination pagination-sm m-0" style="gap:5px;">
                                    <li class="page-item disabled" id="cpPrevLi">
                                        <a id="cpBtnPrev" class="page-link" href="javascript:void(0);"
                                            style="border-radius:30px !important; padding:6px 18px; font-weight:700; color:#4a5568; border-color:#e2e8f0;">⬅️ Previous</a>
                                    </li>
                                    <li class="page-item disabled" id="cpNextLi">
                                        <a id="cpBtnNext" class="page-link" href="javascript:void(0);"
                                            style="border-radius:30px !important; padding:6px 18px; font-weight:700; color:#4a5568; border-color:#e2e8f0;">Next ➡️</a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    var cpCurrentPage = 1, cpTotalPages = 1;

    function createCompleteRow(index, item) {
        return `<tr>
            <td>${index}</td>
            <td>${item.date}</td>
            <td style="font-family:monospace;">${item.time}</td>
            <td><strong>${item.serialNumber}</strong></td>
            <td style="font-weight:700; color:#2d3748;">${item.patientName}</td>
            <td>${item.phone}</td>
            <td>${item.department}</td>
            <td>${item.doctor}</td>
            <td>
                <span style="background:#e9d8fd; color:#44337a; padding:4px 12px; border-radius:20px; font-size:0.75rem; font-weight:700;">
                    <i class="fas fa-check-double me-1"></i> Completed
                </span>
            </td>
        </tr>`;
    }

    function loadComplete(page) {
        cpCurrentPage = page || 1;
        var search = $('#completeSearchBox').val() || '';

        $('#completeTableBody').html(`<tr><td colspan="9" class="text-center py-4">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
            <p class="mt-2 text-muted mb-0">Loading...</p></td></tr>`);

        $.ajax({
            url: '@Url.Action("GetCompleteData", "Appointment")',
            type: 'GET',
            data: { search: search, page: cpCurrentPage, pageSize: 10 },
            dataType: 'json', cache: false,
            success: function (res) {
                if (res.issuccess) {
                    $('#completeTableBody').empty();
                    cpTotalPages = res.totalPages || 1;
                    $('#cpCPage').text(cpCurrentPage); $('#cpTPage').text(cpTotalPages); $('#cpTEntries').text(res.totalItem || 0);
                    $('#cpPrevLi').toggleClass('disabled', cpCurrentPage <= 1);
                    $('#cpNextLi').toggleClass('disabled', cpCurrentPage >= cpTotalPages);
                    if (res.data && res.data.length > 0) {
                        $.each(res.data, function (i, v) { $('#completeTableBody').append(createCompleteRow(((cpCurrentPage - 1) * 10) + i + 1, v)); });
                    } else {
                        $('#completeTableBody').html(`<tr><td colspan="9" class="text-center py-4 text-muted"><i class="fas fa-info-circle fs-4"></i><p class="mt-2 mb-0">No completed appointments found.</p></td></tr>`);
                    }
                }
            },
            error: function () { $('#completeTableBody').html(`<tr><td colspan="9" class="text-center py-4 text-danger">Failed to load data.</td></tr>`); }
        });
    }

    $(document).ready(function () {
        loadComplete(1);
        $('#cpBtnPrev').on('click', function (e) { e.preventDefault(); if (cpCurrentPage > 1) loadComplete(cpCurrentPage - 1); });
        $('#cpBtnNext').on('click', function (e) { e.preventDefault(); if (cpCurrentPage < cpTotalPages) loadComplete(cpCurrentPage + 1); });
        $('#btnCompleteSearch').on('click', function () { loadComplete(1); });
        $('#completeSearchBox').on('keypress', function (e) { if (e.which === 13) { e.preventDefault(); loadComplete(1); } });
    });
</script>
