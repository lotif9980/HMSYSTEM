@{
    ViewData["Title"] = "Appointment - In Progress";
    string activeTab = "progress";
}

<style>
    .appt-card { border:none !important; border-radius:16px !important; box-shadow:0 10px 30px rgba(0,0,0,0.04) !important; background:#ffffff; overflow:hidden; }
    .appt-card-header { background:#ffffff !important; border-bottom:1px solid #f1f2f6 !important; padding:1.25rem 2rem !important; }
    .header-icon { width:44px; height:44px; background:rgba(49,130,206,0.1); color:#3182ce; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.25rem; }
    .appt-card-title { font-size:1.3rem; font-weight:800; color:#2d3748; margin:0; }
    .appt-card-subtitle { font-size:0.82rem; color:#718096; margin:2px 0 0 0; }

    .tab-nav-pills .tab-btn { background:#f7fafc; border:1.5px solid #e2e8f0; color:#4a5568; border-radius:30px !important; padding:6px 18px; font-size:0.85rem; font-weight:700; text-decoration:none !important; transition:all 0.2s ease; display:inline-flex; align-items:center; gap:6px; }
    .tab-nav-pills .tab-btn:hover,.tab-nav-pills .tab-btn.active { background:linear-gradient(135deg,#3182ce 0%,#2b6cb0 100%) !important; color:#ffffff !important; border-color:#3182ce !important; box-shadow:0 4px 12px rgba(49,130,206,0.25); }

    .search-wrapper { position:relative; min-width:240px; }
    .search-wrapper .search-icon { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#a0aec0; font-size:0.9rem; pointer-events:none; }
    .search-wrapper input.search-control { padding-left:40px !important; border-radius:30px !important; border:1.5px solid #e2e8f0 !important; font-size:0.9rem !important; height:38px !important; box-shadow:none !important; background-color:#f7fafc !important; }
    .search-wrapper input.search-control:focus { border-color:#3182ce !important; background-color:#ffffff !important; box-shadow:0 0 0 3px rgba(66,153,225,0.15) !important; }

    .table-container { padding:1rem 1.5rem !important; }
    #progressTable { border-collapse:separate !important; border-spacing:0 !important; width:100% !important; border:none !important; }
    #progressTable th { background-color:#f7fafc !important; color:#4a5568 !important; font-weight:700 !important; text-transform:uppercase !important; font-size:0.75rem !important; letter-spacing:0.8px !important; padding:14px 16px !important; border-bottom:2px solid #edf2f7 !important; border-top:none !important; }
    #progressTable td { padding:13px 16px !important; vertical-align:middle !important; border-bottom:1px solid #edf2f7 !important; color:#2d3748 !important; font-size:0.88rem !important; }
    #progressTable tbody tr:hover { background-color:#f7fafc !important; }

    .action-btn-rx { background:linear-gradient(135deg,#38a169 0%,#276749 100%); color:#ffffff; border:none; border-radius:20px; padding:5px 14px; font-size:0.8rem; font-weight:700; text-decoration:none !important; display:inline-flex; align-items:center; gap:5px; transition:all 0.2s ease; }
    .action-btn-rx:hover { transform:translateY(-1px); box-shadow:0 4px 10px rgba(56,161,105,0.3); color:#ffffff; }

    .pagination .page-link { box-shadow:none !important; color:#4a5568; transition:all 0.2s ease !important; }
    .pagination .page-item:not(.disabled) .page-link:hover { background-color:#3182ce !important; color:#ffffff !important; border-color:#3182ce !important; }
    .pagination .page-item.disabled .page-link { color:#a0aec0 !important; background-color:#f7fafc !important; border-color:#edf2f7 !important; pointer-events:none !important; opacity:0.65; cursor:not-allowed !important; }
</style>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card appt-card mb-4">

                <div class="card-header appt-card-header">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="header-icon"><i class="fas fa-spinner"></i></div>
                            <div>
                                <h3 class="appt-card-title">Appointment — In Progress</h3>
                                <p class="appt-card-subtitle">Appointments currently being attended by doctors.</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <div class="search-wrapper">
                                <i class="fas fa-search search-icon"></i>
                                <input type="text" class="form-control search-control" placeholder="Search..." id="progressSearchBox" />
                            </div>
                            <button type="button" id="btnProgressSearch" class="btn btn-primary"
                                style="border-radius:30px; height:38px; padding:0 1.2rem; font-weight:700; background-color:#3182ce; border-color:#3182ce; display:inline-flex; align-items:center; gap:6px;">
                                <i class="fas fa-search"></i> Search
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Tab Navigation -->
                <div style="background:#f7fafc; border-bottom:1px solid #edf2f7; padding:0.8rem 2rem; display:flex; gap:10px; flex-wrap:wrap;">
                    <div class="tab-nav-pills d-flex gap-2 flex-wrap">
                        <a href="@Url.Action("Index","Appointment")" class="tab-btn"><i class="fas fa-list"></i> Open</a>
                        <a href="@Url.Action("GetProgress","Appointment")" class="tab-btn active"><i class="fas fa-spinner"></i> Progress</a>
                        <a href="@Url.Action("GetComplete","Appointment")" class="tab-btn"><i class="fas fa-check-double"></i> Complete</a>
                        <a href="@Url.Action("GetDeleteList","Appointment")" class="tab-btn"><i class="fas fa-trash-alt"></i> Deleted</a>
                    </div>
                </div>

                <div class="card-body table-container">
                    <table id="progressTable" class="table table-hover">
                        <thead>
                            <tr>
                                <th style="width:55px">Sl No</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Serial</th>
                                <th>Patient Name</th>
                                <th>Phone</th>
                                <th>Department</th>
                                <th>Doctor</th>
                                <th>Status</th>
                                <th style="width:130px; text-align:center">Prescription</th>
                            </tr>
                        </thead>
                        <tbody id="progressTableBody"></tbody>
                    </table>
                </div>

                <div class="card-footer" style="background-color:#ffffff; border-top:1px solid #f1f2f6; padding:1.25rem 2rem;">
                    <div class="row align-items-center">
                        <div class="col-sm-6 text-center text-sm-start mb-3 mb-sm-0">
                            <div class="text-muted" style="font-size:0.85rem;">
                                Showing page <span id="pgCPage" class="fw-bold text-dark">0</span> of
                                <span id="pgTPage" class="fw-bold text-dark">0</span>
                                (<span id="pgTEntries" class="fw-bold text-dark">0</span> total entries)
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <nav class="d-flex justify-content-center justify-content-sm-end">
                                <ul class="pagination pagination-sm m-0" style="gap:5px;">
                                    <li class="page-item disabled" id="pgPrevLi">
                                        <a id="pgBtnPrev" class="page-link" href="javascript:void(0);"
                                            style="border-radius:30px !important; padding:6px 18px; font-weight:700; border-color:#e2e8f0;">⬅️ Previous</a>
                                    </li>
                                    <li class="page-item disabled" id="pgNextLi">
                                        <a id="pgBtnNext" class="page-link" href="javascript:void(0);"
                                            style="border-radius:30px !important; padding:6px 18px; font-weight:700; border-color:#e2e8f0;">Next ➡️</a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Save Prescription Modal -->
<div class="modal fade" id="savePrescriptionModal" tabindex="-1" aria-labelledby="savePrescriptionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" style="border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 15px 50px rgba(0,0,0,0.15);">
            <div class="modal-header" style="background: linear-gradient(135deg, #ed8936 0%, #dd6b20 100%) !important; color: #ffffff !important; padding: 1.25rem 1.75rem;">
                <h5 class="modal-title fw-bold" id="savePrescriptionModalLabel">
                    <i class="fas fa-prescription me-2"></i> Issue Patient Prescription
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: brightness(0) invert(1);"></button>
            </div>
            <form asp-controller="Prescription" asp-action="Save" method="post" id="savePrescriptionForm">
                <input type="hidden" name="AppointmentId" id="modalAppointmentId" value="0" />
                <div class="modal-body" style="background-color: #f8fafc; padding: 1.5rem 1.75rem;">

                    <!-- Master Metadata -->
                    <div class="card p-3 mb-3 border-0 shadow-sm" style="border-radius: 12px;">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label for="modalRxDate" class="form-label fw-bold text-secondary fs-7">Prescription Date</label>
                                <input type="date" name="Date" id="modalRxDate" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label for="modalPatientId" class="form-label fw-bold text-secondary fs-7">Patient</label>
                                <input type="hidden" name="PatientId" id="hiddenPatientId" value="" />
                                <select id="modalPatientId" class="form-select" disabled style="background-color: #e9ecef; cursor: not-allowed;">
                                    <option value="">-- Select Patient --</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="modalDoctorId" class="form-label fw-bold text-secondary fs-7">Doctor</label>
                                <input type="hidden" name="DoctorId" id="hiddenDoctorId" value="" />
                                <select id="modalDoctorId" class="form-select" disabled style="background-color: #e9ecef; cursor: not-allowed;">
                                    <option value="">-- Select Doctor --</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="modalDepartmentId" class="form-label fw-bold text-secondary fs-7">Department</label>
                                <input type="hidden" name="DepartmentId" id="hiddenDepartmentId" value="" />
                                <select id="modalDepartmentId" class="form-select" disabled style="background-color: #e9ecef; cursor: not-allowed;">
                                    <option value="">-- Select Department --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic Medicine Dosage Table -->
                    <div class="card p-3 mb-3 border-0 shadow-sm" style="border-radius: 12px;">
                        <h6 class="fw-bold text-dark mb-3"><i class="fas fa-pills me-2 text-warning"></i> Prescribed Medicines & Dosage Instructions</h6>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle mb-2" id="modalRxDetailsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="min-width: 220px;">Medicine</th>
                                        <th style="width: 130px;">Dose (e.g. 1+0+1)</th>
                                        <th style="width: 130px;">Duration (e.g. 7 Days)</th>
                                        <th style="width: 140px; text-align: center;">After Meal?</th>
                                        <th style="width: 60px; text-align: center;">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="modalRxDetailsBody">
                                    <!-- Dynamic Rows -->
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-end mt-2">
                            <button type="button" id="modalRxAddRowBtn" class="btn btn-sm btn-warning text-white" style="border-radius: 20px; padding: 4px 16px; font-weight: 700; background-color: #ed8936; border: none;">
                                <i class="fas fa-plus me-1"></i> Add Medicine
                            </button>
                        </div>
                    </div>

                    <!-- Advice & Follow-Up Card -->
                    <div class="card p-3 border-0 shadow-sm" style="border-radius: 12px;">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label for="modalRxNote" class="form-label fw-bold text-secondary fs-7">Medical Advice / Note</label>
                                <input type="text" name="Note" id="modalRxNote" class="form-control" placeholder="e.g. Drink plenty of water. Take rest. (Use '.' for bullet breaks)" />
                            </div>
                            <div class="col-md-4">
                                <label for="modalNextFlowUp" class="form-label fw-bold text-secondary fs-7">Follow-Up Date</label>
                                <input type="date" name="NextFlowUp" id="modalNextFlowUp" class="form-control" />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="modal-footer d-flex justify-content-center" style="background-color: #f7fafc; padding: 1rem 1.75rem;">
                    <button type="submit" class="btn btn-warning text-white fw-bold px-4" style="border-radius: 30px; background: linear-gradient(135deg, #ed8936 0%, #dd6b20 100%) !important; border: none; box-shadow: 0 4px 12px rgba(237,137,54,0.3);">
                        <i class="fas fa-save me-2"></i> Issue Prescription
                    </button>
                    <button type="button" class="btn btn-secondary fw-bold px-4" data-bs-dismiss="modal" style="border-radius: 30px;">
                        <i class="fas fa-times me-2"></i> Close
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    var pgCurrentPage = 1, pgTotalPages = 1;
    var modalMedicinesList = [];

    function showSuccess(msg) {
        if (typeof toastr !== 'undefined') toastr.success(msg); else alert(msg);
    }

    function showError(msg) {
        if (typeof toastr !== 'undefined') toastr.error(msg); else alert(msg);
    }

    function buildMedOptions() {
        let html = '<option value="">-- Select Medicine --</option>';
        if (modalMedicinesList && modalMedicinesList.length > 0) {
            $.each(modalMedicinesList, function (i, m) {
                html += `<option value="${m.id}">${m.name}</option>`;
            });
        }
        return html;
    }

    function addRxRow() {
        var rowIndex = $('#modalRxDetailsBody tr').length;
        var medOpts = buildMedOptions();

        var newRow = `<tr>
            <td>
                <select name="PrescriptionDetails[${rowIndex}].MedicineId" class="form-select modal-rx-medicine" required>
                    ${medOpts}
                </select>
            </td>
            <td><input type="text" name="PrescriptionDetails[${rowIndex}].Dose" class="form-control" placeholder="1+0+1" required /></td>
            <td><input type="text" name="PrescriptionDetails[${rowIndex}].Duration" class="form-control" placeholder="7 Days" required /></td>
            <td style="text-align: center;">
                <input type="checkbox" name="PrescriptionDetails[${rowIndex}].Instructions" value="true" class="form-check-input mt-2" style="width: 20px; height: 20px;" />
            </td>
            <td style="text-align: center;">
                <button type="button" class="btn btn-sm btn-danger remove-modal-rx-row-btn"><i class="fas fa-trash"></i></button>
            </td>
        </tr>`;
        $('#modalRxDetailsBody').append(newRow);
    }

    function createProgressRow(index, item) {
        return `<tr>
            <td>${index}</td>
            <td>${item.date}</td>
            <td style="font-family:monospace;">${item.time}</td>
            <td><strong>${item.serialNumber}</strong></td>
            <td style="font-weight:700; color:#2d3748;">${item.patientName}</td>
            <td>${item.phone}</td>
            <td>${item.department}</td>
            <td>${item.doctor}</td>
            <td>
                <span style="background:#bee3f8; color:#1a365d; padding:4px 12px; border-radius:20px; font-size:0.75rem; font-weight:700;">
                    <i class="fas fa-spinner fa-spin me-1"></i> In Progress
                </span>
            </td>
            <td style="text-align:center;">
                <a class="action-btn-rx open-rx-modal-btn" href="javascript:void(0);" data-appointmentid="${item.appointmentId}">
                    <i class="fas fa-prescription me-1"></i> Prescription
                </a>
            </td>
        </tr>`;
    }

    function loadProgress(page) {
        pgCurrentPage = page || 1;
        var search = $('#progressSearchBox').val() || '';

        $('#progressTableBody').html(`<tr><td colspan="10" class="text-center py-4">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
            <p class="mt-2 text-muted mb-0">Loading...</p></td></tr>`);

        $.ajax({
            url: '@Url.Action("GetProgressData", "Appointment")',
            type: 'GET',
            data: { search: search, page: pgCurrentPage, pageSize: 10 },
            dataType: 'json', cache: false,
            success: function (res) {
                if (res.issuccess) {
                    $('#progressTableBody').empty();
                    pgTotalPages = res.totalPages || 1;
                    var totalItem = res.totalItem || 0;
                    $('#pgCPage').text(totalItem > 0 ? pgCurrentPage : 0); $('#pgTPage').text(pgTotalPages); $('#pgTEntries').text(totalItem);
                    $('#pgPrevLi').toggleClass('disabled', pgCurrentPage <= 1);
                    $('#pgNextLi').toggleClass('disabled', pgCurrentPage >= pgTotalPages || totalItem === 0);
                    if (res.data && res.data.length > 0) {
                        $.each(res.data, function (i, v) { $('#progressTableBody').append(createProgressRow(((pgCurrentPage - 1) * 10) + i + 1, v)); });
                    } else {
                        $('#progressTableBody').html(`<tr><td colspan="10" class="text-center py-4 text-muted"><i class="fas fa-info-circle fs-4"></i><p class="mt-2 mb-0">No in-progress appointments found.</p></td></tr>`);
                    }
                }
            },
            error: function () { $('#progressTableBody').html(`<tr><td colspan="10" class="text-center py-4 text-danger">Failed to load data.</td></tr>`); }
        });
    }

    $(document).ready(function () {
        loadProgress(1);
        $('#pgBtnPrev').on('click', function (e) { e.preventDefault(); if ($('#pgPrevLi').hasClass('disabled')) return; if (pgCurrentPage > 1) loadProgress(pgCurrentPage - 1); });
        $('#pgBtnNext').on('click', function (e) { e.preventDefault(); if ($('#pgNextLi').hasClass('disabled')) return; if (pgCurrentPage < pgTotalPages) loadProgress(pgCurrentPage + 1); });
        $('#btnProgressSearch').on('click', function () { loadProgress(1); });
        $('#progressSearchBox').on('keypress', function (e) { if (e.which === 13) { e.preventDefault(); loadProgress(1); } });

        // Open Prescription Modal on Prescription Button Click
        $(document).on('click', '.open-rx-modal-btn', function () {
            var apptId = $(this).data('appointmentid');
            $.ajax({
                url: '@Url.Action("GetSaveModalData", "Prescription")',
                type: 'GET',
                data: { appointmentId: apptId },
                success: function (res) {
                    if (res.success) {
                        modalMedicinesList = res.medicines || [];

                        // Populate Patient Dropdown
                        var $patSelect = $('#modalPatientId');
                        $patSelect.empty().append('<option value="">-- Select Patient --</option>');
                        $.each(res.patients || [], function (i, p) {
                            $patSelect.append(`<option value="${p.id}">${p.name} (${p.phone || ''})</option>`);
                        });

                        // Populate Doctor Dropdown
                        var $docSelect = $('#modalDoctorId');
                        $docSelect.empty().append('<option value="">-- Select Doctor --</option>');
                        $.each(res.doctors || [], function (i, d) {
                            $docSelect.append(`<option value="${d.id}">Dr. ${d.name}</option>`);
                        });

                        // Populate Department Dropdown
                        var $deptSelect = $('#modalDepartmentId');
                        $deptSelect.empty().append('<option value="">-- Select Department --</option>');
                        $.each(res.departments || [], function (i, dp) {
                            $deptSelect.append(`<option value="${dp.id}">${dp.name}</option>`);
                        });

                        // Set Appointment Data
                        if (res.appointment) {
                            var a = res.appointment;
                            $('#modalAppointmentId').val(a.appointmentId);
                            $patSelect.val(a.patientId).prop('disabled', true);
                            $('#hiddenPatientId').val(a.patientId);

                            $docSelect.val(a.doctorId).prop('disabled', true);
                            $('#hiddenDoctorId').val(a.doctorId);

                            $deptSelect.val(a.departmentId).prop('disabled', true);
                            $('#hiddenDepartmentId').val(a.departmentId);
                        } else {
                            $('#modalAppointmentId').val(0);
                            $('#hiddenPatientId').val(0);
                            $('#hiddenDoctorId').val(0);
                            $('#hiddenDepartmentId').val(0);
                        }

                        // Reset Date & Rows
                        var today = new Date().toISOString().split('T')[0];
                        $('#modalRxDate').val(today);

                        var followUp = new Date();
                        followUp.setDate(followUp.getDate() + 7);
                        $('#modalNextFlowUp').val(followUp.toISOString().split('T')[0]);

                        $('#modalRxNote').val('');
                        $('#modalRxDetailsBody').empty();
                        addRxRow();

                        var modal = new bootstrap.Modal(document.getElementById('savePrescriptionModal'));
                        modal.show();
                    } else {
                        showError("Failed to load prescription form data.");
                    }
                },
                error: function () {
                    showError("Error connecting to server.");
                }
            });
        });

        // Add Medicine Row in Modal
        $('#modalRxAddRowBtn').on('click', function () {
            addRxRow();
        });

        // Remove Medicine Row in Modal
        $('#modalRxDetailsTable').on('click', '.remove-modal-rx-row-btn', function () {
            $(this).closest('tr').remove();
        });

        // Submit Prescription Form via AJAX
        $('#savePrescriptionForm').on('submit', function (e) {
            e.preventDefault();
            var form = $(this);
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (res) {
                    if (res.success) {
                        showSuccess(res.message || '✅ Prescription Successfully Saved & Issued!');
                        $('#savePrescriptionModal').modal('hide');
                        loadProgress(pgCurrentPage);
                    } else {
                        showError(res.message || '❌ Prescription save failed');
                    }
                },
                error: function (xhr, status, error) {
                    showError('❌ An error occurred: ' + error);
                }
            });
        });
    });
</script>
